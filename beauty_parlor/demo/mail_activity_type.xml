<?xml version='1.0' encoding='UTF-8'?>
<odoo auto_sequence="1" noupdate="1">
  <record id="mail.mail_activity_data_todo" model="mail.activity.type" forcecreate="1">
    <field name="name">To-Do</field>
    <field name="summary">To-Do</field>
    <field name="delay_count">5</field>
    <field name="icon">fa-check</field>
  </record>
  <record id="mail.mail_activity_data_email" model="mail.activity.type" forcecreate="1">
    <field name="name">Email</field>
    <field name="summary">Email</field>
    <field name="icon">fa-envelope</field>
  </record>
  <record id="mail.mail_activity_data_call" model="mail.activity.type" forcecreate="1">
    <field name="name">Call</field>
    <field name="summary">Call</field>
    <field name="delay_count">2</field>
    <field name="icon">fa-phone</field>
    <field name="category">phonecall</field>
  </record>
  <record id="mail.mail_activity_data_meeting" model="mail.activity.type" forcecreate="1">
    <field name="name">Meeting</field>
    <field name="summary">Meeting</field>
    <field name="icon">fa-users</field>
    <field name="category">meeting</field>
  </record>
  <record id="point_of_sale.mail_activity_old_session" model="mail.activity.type" forcecreate="1">
    <field name="name">Session open over 7 days</field>
    <field name="summary">note</field>
    <field name="icon">fa-tasks</field>
    <field name="res_model">pos.session</field>
  </record>
  <record id="mail.mail_activity_data_upload_document" model="mail.activity.type" forcecreate="1">
    <field name="name">Document</field>
    <field name="summary">Document</field>
    <field name="delay_count">5</field>
    <field name="icon">fa-upload</field>
    <field name="category">upload_file</field>
  </record>
</odoo>
