<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_sale_product_attribute_filters_form" model="ir.ui.view">
        <field name="name">Custom Bike - Product Attribute Filters Form</field>
        <field name="key">website_sale.product_attribute_filters_form</field>
        <field name="inherit_id" ref="website_sale.product_attribute_filters_form"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="replace">
                <t name="Product Attribute Filters Form" t-name="website_sale.product_attribute_filters_form">
                    <form t-attf-class="js_attributes {{('accordion accordion-flush d-flex flex-column ' + ('border-bottom' if attributes else '')) if isMobile else 'position-relative mb-2'}}" method="get" t-att-action="keep(**reset_attribute_value_params, tags=0)">
                        <t t-foreach="attributes" t-as="a">
                            <t t-set="_status" t-value="'inactive'"/>
                            <t t-set="current_attribute_pavs" t-value="pavs_per_attribute[a]"/>
                            <t t-foreach="current_attribute_pavs" t-as="v" t-if="v.id in attrib_set" t-set="_status" t-value="'active'"/>
                            <t t-set="_expand_attributes" t-value="_status == 'active' or default_expand_filter_sections"/>
                            <div t-if="current_attribute_pavs" t-attf-class="accordion-item {{('border-top-0 ' + ('order-1' if _status == 'active' else 'order-2')) if isMobile else 'nav-item mb-1 rounded-0'}}">
                                <h2 t-if="isMobile" class="accordion-header mb-0" t-attf-id="o_wsale_offcanvas_attribute_{{a.id}}_header">
                                    <button t-attf-class="o_wsale_offcanvas_title accordion-button px-4 bg-transparent shadow-none {{'' if _expand_attributes else 'collapsed'}}" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="#o_wsale_offcanvas_attribute_{{a.id}}" t-att-aria-expanded="_expand_attributes" t-attf-aria-controls="o_wsale_offcanvas_attribute_{{a.id}}">
                                        <b t-out="a.name"/>
                                    </button>
                                </h2>
                                <div t-else="" class="mb-3">
                                    <b class="d-none d-lg-block" t-field="a.name"/>
                                </div>
                                <div t-attf-id="{{'o_wsale_offcanvas_attribute_' + str(a.id) if isMobile else 'o_products_attributes_' + str(a.id)}}" t-attf-class="{{'accordion-collapse collapse ' + ('show' if _expand_attributes else '') if isMobile else ''}}">
                                    <div t-attf-class="{{'accordion-body pt-0' if isMobile else ''}}">
                                        <div t-if="a.display_type == 'select'" t-attf-class="{{'my-2' if isMobile else 'mb-3'}}">
                                            <t t-call="website_sale.filter_select_attributes"/>
                                        </div>
                                        <div t-elif="a.display_type == 'color'" t-attf-class="d-flex flex-wrap gap-2 {{'pt-2 pb-3' if isMobile else 'mb-3'}}">
                                            <t t-call="website_sale.filter_color_attributes"/>
                                        </div>
                                        <div t-elif="a.display_type == 'image'" t-attf-class="d-flex flex-wrap gap-2 #{'pt-1 pb-3' if isMobile else 'mb-3'}">
                                            <t t-call="website_sale.filter_image_attributes"/>
                                        </div>
                                        <div t-elif="a.display_type in ('radio', 'multi')" t-attf-class="{{'list-group list-group-flush' if isMobile else 'flex-column mb-3'}}">
                                            <t t-call="website_sale.filter_radio_and_multi_attributes" isMobile="isMobile"/>
                                        </div>
                                        <div t-elif="a.display_type == 'pills'" t-attf-class="d-flex flex-wrap gap-2 {{'my-2' if isMobile else 'mb-3'}}" data-bs-toggle="buttons">
                                            <t t-call="website_sale.filter_pills_attributes"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="isMobile">
                            <t t-if="opt_wsale_filter_tags and (opt_wsale_attributes or opt_wsale_attributes_top)">
                                <t t-set="_status" t-value="'inactive'"/>
                                <t t-foreach="all_tags" t-as="v" t-if="v.id in tags" t-set="_status" t-value="'active'"/>
                                <t t-set="_expand_tags" t-value="_status == 'active' or default_expand_filter_sections"/>
                                <div t-if="all_tags" class="order-3">
                                    <h2 class="accordion-header mb-0" t-attf-id="o_wsale_offcanvas_tags_header">
                                        <button t-attf-class="o_wsale_offcanvas_title accordion-button rounded-0 {{not _expand_tags and 'collapsed'}}" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="#o_wsale_offcanvas_tags" t-att-aria-expanded="_expand_tags" t-attf-aria-controls="o_wsale_offcanvas_tags" class="o_wsale_offcanvas_title accordion-button rounded-0">
                                            <b>Étiquettes</b>
                                        </button>
                                    </h2>
                                    <div t-attf-id="o_wsale_offcanvas_tags" t-attf-class="accordion-collapse collapse {{_expand_tags and 'show'}}" t-att-aria-expanded="_expand_tags" t-attf-aria-labelledby="o_wsale_offcanvas_tags_header">
                                        <div class="accordion-body pt-0">
                                            <div class="list-group list-group-flush">
                                                <t t-call="website_sale.filter_products_tags_list" all_tags="all_tags"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <t t-if="opt_wsale_filter_tags and opt_wsale_attributes" t-call="website_sale.filter_products_tags" all_tags="all_tags">
                            </t>
                        </t>
                    </form>
                </t>
            </xpath>
        </field>
    </record>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom Bike - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
            © <span>offtrack, 2026</span></span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
