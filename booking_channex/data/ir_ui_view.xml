<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- channex mapping views -->
    <record id="x_channex_mapping_form_view" model="ir.ui.view">
        <field name="model">x_channex_mapping</field>
        <field name="name">Mapping Table Form</field>
        <field name="active" eval="True"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_model_type" />
                        <field name="x_local_id" />
                    </group>
                    <group>
                        <field name="x_remote_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="x_channex_mapping_search_view" model="ir.ui.view">
        <field name="name">x.channex.mapping.search</field>
        <field name="model">x_channex_mapping</field>
        <field name="active" eval="True"/>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <filter name="group_by_model_type" string="Model Type" context="{'group_by': 'x_model_type'}"/>
            </search>
        </field>
    </record>
    <record id="x_channex_mapping_list_view" model="ir.ui.view">
        <field name="model">x_channex_mapping</field>
        <field name="name">Mapping Table list</field>
        <field name="active" eval="True"/>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_model_type" />
                <field name="x_local_id" />
                <field name="x_remote_id" />
            </list>
        </field>
    </record>

    <!-- rate plan views -->
    <record id="x_rate_plan_form_view" model="ir.ui.view">
        <field name="model">x_rate_plan</field>
        <field name="name">Rate Plan Form</field>
        <field name="active" eval="True"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="x_name"/>
                    </h1>
                    <group>
                        <field name="x_variant_id" domain="[('x_is_a_room_offer', '=', True)]"/>
                        <field name="x_rate_plan_value_id"/>
                        <field name="x_pricelist_id" />
                        <field name="x_total_inventory" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="x_rate_plan_list_view" model="ir.ui.view">
        <field name="model">x_rate_plan</field>
        <field name="name">Rate Plan list</field>
        <field name="active" eval="True"/>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_variant_id" domain="[('x_is_a_room_offer', '=', True)]"/>
                <field name="x_rate_plan_value_id"/>
                <field name="x_pricelist_id" />
                <field name="x_total_inventory" />
            </list>
        </field>
    </record>

    <!-- Channex Groups views -->
    <record id="x_channex_group_form_view" model="ir.ui.view">
        <field name="model">x_channex_group</field>
        <field name="name">x_channex_group.form</field>
        <field name="active" eval="True"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <h1>
                        <field name="x_name"/>
                    </h1>
                    <group>
                        <field name="x_company_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="x_channex_group_list_view" model="ir.ui.view">
        <field name="model">x_channex_group</field>
        <field name="name">x_channex_group.list</field>
        <field name="active" eval="True"/>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="x_name"/>
                <field name="x_company_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="x_channex_group_remove_from_group_form_view" model="ir.ui.view">
        <field name="model">x_remove_company_channex_wizard</field>
        <field name="name">x.remove.company.channex.wizard.remove.from.group</field>
        <field name="active" eval="True"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div>
                        You are about to remove this company as property from its Channex group.
                    </div>
                    <div>
                        As a result, all data from the corresponding property will be lost on Channex.
                    </div>
                    <div>
                        <br/>
                        This action is irreversible.
                    </div>
                    <footer>
                        <button class="btn-primary" type="action" string="Proceed"
                            name="%(action_remove_property_from_channex)d"/>
                        <button class="btn-secondary" special="cancel" string="Cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- res company views -->
    <record id="res_company_channex_form_view" model="ir.ui.view">
        <field name="name">res.company.channex.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="type">form</field>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group[1]/group[1]" position="inside">
                <label for="x_channex_group_id" string="Channex Group"/>
                <div class="d-flex">
                    <field class="oe_inline flex-grow-1" widget="selection" name="x_channex_group_id" readonly="x_is_in_channex_group"/>
                    <button class="oe_inline btn btn-link pt-0" type="action" string="Remove From Group"
                        name="%(open_remove_company_from_group_action)d" invisible="not x_is_in_channex_group" context="{'default_x_company_id': id}"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="res_company_channex_list_view" model="ir.ui.view">
        <field name="name">res.company.channex.list</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="type">list</field>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='child_ids']" position="after">
                <field name="x_channex_group_id" readonly="True"/>
            </xpath>
        </field>
    </record>
    <!-- ARI Updates send lines views -->
    <record id="x_channex_ari_update_lines_list_view" model="ir.ui.view">
        <field name="arch" type="xml">
            <list>
                <field name="x_payload" />
                <field name="x_operation" />
            </list>
        </field>
        <field name="model">x_channex_ari_update_lines</field>
        <field name="name">Datas cron lines list</field>
        <field name="active" eval="True"/>
        <field name="type">list</field>
    </record>
    <!-- product pricelit views -->
    <record id="product_pricelist_view" model="ir.ui.view">
        <field name="name">booking.channex.product.pricelist.form.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="active" eval="True"/>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="x_published_on_channex"/>
            </xpath>
        </field>
    </record>
    <!-- ir cron views -->
    <record id="ir_cron_extends" model="ir.ui.view">
        <field name="arch" type="xml">
            <xpath expr="//field[@name='group_ids']" position="after">
                <field name="x_debug_last_answer"/>
            </xpath>
        </field>
        <field name="inherit_id" ref="base.ir_cron_view_form"/>
        <field name="model">ir.cron</field>
        <field name="name">ir.cron form view extension</field>
        <field name="active" eval="True"/>
        <field name="type">form</field>
    </record>
    <!-- product template views-->
    <record id="product_form_view" model="ir.ui.view">
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']//field[@name='company_id']" position="attributes">
                <attribute name="required">x_is_a_room_offer</attribute>
            </xpath>
        </field>
        <field name="inherit_id" ref="sale_planning.product_template_form_view_invoice_policy_inherit_sale_planning"/>
        <field name="mode">extension</field>
        <field name="model">product.template</field>
        <field name="name">product.template.product.form.inherit.booking_channex</field>
        <field name="priority">160</field>
        <field name="type">form</field>
        <field name="active" eval="True"/>
    </record>
    <record id="booking_channex_offers_form" model="ir.ui.view">
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="alert" style="height: 40px; margin-bottom:0px;" invisible="x_has_guests_attribute">
                    Guests attribute shall be present with one or more values to capture the capability on Channex.
                </div>
                <div class="alert alert-info" role="alert" style="height: 40px; margin-bottom:0px;" invisible="x_has_rates_attribute">
                    Rate Plan attribute shall be present with one or more values to capture the rate plans on Channex.
                </div>
                <div class="alert alert-info" role="alert" style="height: 40px; margin-bottom:0px;" invisible="x_resource_ids">
                    Resources shall be assigned to capture the room count on Channex.
                </div>
            </xpath>
            <xpath expr="//group[@name='group_general_info']/group[1]" position="inside">
                <field name="company_id" required="x_is_a_room_offer" groups="base.group_multi_company"/>
            </xpath>
            <xpath expr="//group[@name='group_house_keeping_info']" position="before">
            <group string="Channel Manager" name="group_channel_manager_info">
                <field name="x_ota_buffer"/>
                <field name="x_offer_type"/>
                <field name="x_stop_sell" widget="boolean_toggle"/>
            </group>
            </xpath>
        </field>
        <field name="inherit_id" ref="booking_engine.booking_engine_offers_form"/>
        <field name="mode">extension</field>
        <field name="model">product.template</field>
        <field name="name">product.template.form.inherit.booking_channex</field>
        <field name="type">form</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
