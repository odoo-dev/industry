<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Channex API Key Setting -->
    <record id="x_setting_field_channel_manager_api_key" model="ir.model.fields">
        <field name="ttype">char</field>
        <field name="field_description">API Key</field>
        <field name="model_id" ref="base_setup.model_res_config_settings"/>
        <field name="name">x_channex_api_key</field>
        <field name="compute"><![CDATA[
self['x_channex_api_key'] = self.env['ir.config_parameter'].get_str('booking_channex.x_channex_api_key')
]]></field>
    </record>
    <record id="x_action_set_api_key" model="ir.actions.server">
        <field name="code"><![CDATA[
env['ir.config_parameter'].set_str('booking_channex.x_channex_api_key', (record.x_channex_api_key))
]]></field>
        <field name="model_id" ref="base_setup.model_res_config_settings"/>
        <field name="state">code</field>
        <field name="name">Set Channex API Key</field>
    </record>
    <!-- TODO fix Error when uninstalling Channex, this records is scheduled to run afterwards and fails as it is uninstalled -->
    <record id="automation_on_settings_api_key_write" model="base.automation">
        <field name="model_id" ref="base_setup.model_res_config_settings"/>
        <field name="name">Set API Key</field>
        <field name="trigger">on_create_or_write</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('x_action_set_api_key')])]"/>
        <field name="on_change_field_ids" eval="[(6, 0, [ref('x_setting_field_channel_manager_api_key')])]"/>
    </record>

    <record id="x_setting_field_channel_manager_is_synced" model="ir.model.fields">
        <field name="ttype">boolean</field>
        <field name="field_description">Channex is Synced</field>
        <field name="model_id" ref="base_setup.model_res_config_settings"/>
        <field name="name">x_channex_is_synced</field>
        <field name="store" eval="False"/>
        <field name="compute"><![CDATA[
self['x_channex_is_synced'] = self.env['ir.config_parameter'].get_str('booking_channex.synced_with_channex')
]]></field>
    </record>
    
    <data noupdate="1">
        <record model="res.config.settings" id="res_config_settings_enable">
            <field name="x_setting_steering" eval="1"/>
        </record>
        <function model="res.config.settings" name="execute" eval="[ref('res_config_settings_enable')]"/>
    </data>
    <record id="booking_engine.automation_on_x_setting_steering_set" model="base.automation" forcecreate="0">
        <field name="active" eval="0"/>
    </record>

    <!-- Views -->
    <record id="res_config_settings_form_view_inherited_sync" model="ir.ui.view">
        <field name="name">res.config.settings.form.view.inherited.booking.engine.sync</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="active" eval="True"/>
        <field name="inherit_id" ref="booking_engine.res_config_settings_form_view_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='booking_engine_channel_manager_setting']//div" position="replace">
                <div class="content-group" invisible="not x_module_channel_manager">
                    <div class="row mt16">
                        <label for="x_channex_api_key" class="col-lg-3" invisible="not x_module_channel_manager"/>
                        <field name="x_channex_api_key" required="x_module_channel_manager" invisible="not x_module_channel_manager"/>
                    </div>
                </div>
                <div invisible="not x_module_channel_manager" class="oe_inline">
                        <button
                            type="action"
                            name="%(action_button_sync)d"
                            class="btn-primary"
                            invisible="x_channex_is_synced"
                        >
                            Sync
                        </button>
                        <button
                            type="action"
                            name="%(fetch_channex_and_capture_changes_needed)d"
                            class="btn-primary"
                            invisible="not x_channex_is_synced"
                        >
                            Sync
                        </button>
                    </div>
            </xpath>
            <xpath expr="//setting[@id='booking_engine_steering_setting']" position="inside">
                <div class="text-warning mb4">
                    Channel Manager dependency
                </div>
            </xpath>
            <xpath expr="//field[@name='x_setting_steering']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
