<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Custom La Table - Header Call to Action</field>
        <field name="key">website.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/contactus" class="oe_unremovable btn btn-primary btn_cta w-100">CONTACT US</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="template_footer_descriptive" model="ir.ui.view">
        <field name="name">Custom La Table - Descriptive Footer</field>
        <field name="key">website.template_footer_descriptive</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-top-width: 0px; --box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pb4 pt64" data-snippet="s_text_block" data-name="Container">

                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="col-lg-12 o_colored_level pt256 pb256 order-lg-0" style="order: 0;">
                                    <h2 style="text-align: center;"><span style="font-size: clamp(8px, 1em + 3.125vw, 400px);" class="o_rfs"><span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 10;"/><a href="/contactus" class="o_translate_inline"><span class="text-o-color-1"><span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom o_animated" style="--wanim-intensity: 10; visibility: visible; animation-play-state: running;">Make</span> <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom o_animated" style="--wanim-intensity: 10; animation-delay: 0.25s; visibility: visible; animation-play-state: running;">it</span></span></a><span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 10; animation-delay: 0.25s;"/></span></h2><h2 style="text-align: center;"><span style="font-size: clamp(8px, 1em + 3.125vw, 400px);" class="o_rfs"><em><span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 10; animation-delay: 0.5s;"><a href="/contactus" class="o_translate_inline"><span class="text-o-color-1">happen.</span></a></span></em></span></h2>
                                    <p class="lead mt16" style="text-align: center;"><br/></p><p class="lead mt16" style="text-align: center;"><span style="font-size: 14px;"><span class="o_animated_text o_animate o_anim_fade_in o_visible" style="animation-delay: 0.75s;">WE CARE FOR EVERY DETAIL</span></span></p>
                                </div><div class="o_colored_level pt0 pb0 o_animate o_anim_fade_in o_visible col-lg-3 order-lg-0 col-12" style="animation-duration: 0.5s; animation-delay: 1.15s; order: 2; animation-name: dummy;">
                                    <p class="mt16 small" style="text-align: center;"><span style="font-size: clamp(8px, 1em - 0.2451vw, 400px);" class="o_rfs">© COPYRIGHT. LA TABLE. ALL RIGHTS RESERVED</span></p>
                                </div><div class="pt0 pb0 o_colored_level o_animate o_anim_fade_in o_visible col-lg-5 offset-lg-4 order-lg-0 col-12" style="animation-duration: 0.5s; animation-delay: 1s; order: 1; animation-name: dummy;">
                                    <p class="mt16 small" style="text-align: center;"><span style="font-size: clamp(8px, 1em - 0.2451vw, 400px);" class="o_rfs">LA TABLE. 12 RUE DE CEUTA. 1000 BRUXELLES. +32 488 66 55 11. <span class="o_text_highlight o_text_highlight_underline" style="--text-highlight-color: var(--o-color-1); --text-highlight-width: 1px;"><a href="mailto:INFO@LATABLE.EXAMPLE.COM" class="o_translate_inline">INFO@LATABLE.EXAMPLE.COM</a></span>&amp;nbsp;</span></p>
                                </div>


                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
