<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="odoo_studio_res_part_64aa1621-8180-4c27-9e32-9234d364cfcd" model="ir.ui.view" context="{'studio': True}">
    <field name="arch" type="xml">
      <data>
        <xpath expr="/form/sheet/group" position="replace">
          <group name="studio_group_4kb_1jjghjvij">
            <group name="studio_group_4kb_left">
              <label for="x_studio_date_of_birth"/>
              <div class="d-flex justify-content-between align-items-center" name="x_studio_date_of_birth">
                <field name="x_studio_date_of_birth" class="oe_inline w-50" force_save="1"/>
                <span class="oe_inline" invisible="not x_studio_date_of_birth">Age <field name="x_studio_age" class="oe_inline" options="{'digits':[0,0]}"/>
          </span>
              </div>
            </group>
          </group>
        </xpath>
        <xpath expr="/form//button[@name='action_view_tasks']" position="replace"/>
        <xpath expr="/form/sheet/div[2]/div/div/div/field[@name='parent_id']" position="replace"/>
        <xpath expr="/form//page[@name='geo_location']" position="replace"/>
        <xpath expr="/form//page[@name='sales_purchases']" position="replace"/>
        <xpath expr="/form//page[@name='internal_notes']" position="after">
          <page string="Medical &amp; Safety" name="studio_page_8gk_1jjgk1n75">
            <group name="studio_group_8gk">
              <group name="studio_group_8gk_left">
                <field name="x_studio_allergies" widget="many2many_tags"/>
                <field name="x_studio_blood_type"/>
                <field name="x_studio_health_insurance"/>
              </group>
              <group name="studio_group_8gk_right">
                <field name="x_studio_current_medications" help="Dosage, frequency, and administration instructions."/>
              </group>
            </group>
          </page>
          <page string="Placement" name="studio_page_3ti_1jjgkm5n6">
            <group name="studio_group_3ti">
              <group name="studio_group_3ti_left">
                <field name="x_studio_admission_date"/>
                <field name="x_studio_legal_status"/>
                <field name="x_studio_projected_exit_date"/>
                <field name="x_studio_effective_exit_date" help="To fill in on resident leave."/>
              </group>
              <group name="studio_group_3ti_right">
                <field name="x_studio_nicknames"/>
                <field widget="many2many_tags" name="x_studio_languages"/>
                <field name="x_studio_special_needs" help="e.g. IEP/Special Education status, speech therapy schedule"/>
              </group>
            </group>
          </page>
        </xpath>
        <xpath expr="/form//field[@name='child_ids']" position="replace">
          <field name="x_studio_contacts">
            <list editable="bottom">
              <field name="x_studio_sequence" widget="handle"/>
              <field optional="show" name="x_studio_contact" required="True" widget="many2one_avatar" options="{&quot;no_open&quot;:false}" domain="[(&quot;x_studio_is_resident&quot;, &quot;=&quot;, False)]"/>
              <field widget="many2many_tags" optional="show" name="x_studio_nature" required="True"/>
              <field optional="show" name="x_studio_notes"/>
            </list>
          </field>
        </xpath>
      </data>
    </field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="mode">extension</field>
    <field name="model">res.partner</field>
    <field name="name">Odoo Studio: res.partner.form customization</field>
    <field name="priority">160</field>
    <field name="type">form</field>
  </record>
  <record id="odoo_studio_res_part_49d00aad-cbf4-46f3-a068-a378b983a987" model="ir.ui.view" context="{'studio': True}">
    <field name="arch" type="xml">
      <data>
        <xpath expr="/search//filter[@name='employees']" position="replace"/>
        <xpath expr="/search//field[@name='parent_id']" position="replace"/>
        <xpath expr="/search//field[@name='user_id']" position="replace"/>
        <xpath expr="/search/separator[2]" position="replace">
          <separator name="studio_separator_4e7_1jjgp6pb6"/>
          <filter name="studio_filter_by_5h1_1jjgp6gik" string="Date of Birth" date="x_studio_date_of_birth"/>
        </xpath>
        <xpath expr="/search//filter[@name='group_company']" position="replace"/>
        <xpath expr="/search//filter[@name='salesperson']" position="replace"/>
      </data>
    </field>
    <field name="inherit_id" ref="base.view_res_partner_filter"/>
    <field name="mode">extension</field>
    <field name="model">res.partner</field>
    <field name="name">Odoo Studio: res.partner.select customization</field>
    <field name="priority">160</field>
    <field name="type">search</field>
  </record>
