<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record model="ir.ui.view" id="view_calendar_event_form_inherit">
        <field name="name">calendar.event.view.form.inherit.construction_developer</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="type">form</field>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_invitations']" position="after">
                <page name="remarks" string="Remarks">
                    <group class="mb-0">
                        <field name="x_project_id" class="mb-0"/>
                    </group>
                    <field name="x_remark_ids" readonly="not x_project_id" nolabel="1" context="{
                        'default_x_project_id': x_project_id,
                        'default_x_event_id': id,
                        'list_view_ref': 'construction_developer.view_x_remark_list_one2many',
                    }"/>
                </page>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="mrp_bom_form_view_inherit">
        <field name="name">mrp.bom.view.form.inherit.construction_developer</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="active" eval="True"/>
        <field name="priority">1600</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tmpl_id']/.." position="inside">
                <label
                    for="x_is_template"
                    string="Is Template"
                    invisible="type != 'normal'"
                />
                <div
                    name="is_template"
                    invisible="type != 'normal'"
                >
                    <field name="x_is_template"/>
                    <button
                        name="%(action_set_template_bom_on_product)d"
                        type="action"
                        string="Set as Template"
                        class="btn btn-link px-0"
                        invisible="x_is_template"
                    />
                </div>
            </xpath>
            <xpath expr="//field[@name='code']/.." position="inside">
                <field name="x_currency_id" invisible="True"/>

                <field name="x_unit_cost" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                <label for="x_bom_cost" invisible="x_unit_cost == x_bom_cost"/>
                <div name="x_bom_cost" invisible="x_unit_cost == x_bom_cost">
                    <field name="x_bom_cost" widget="monetary" options="{'currency_field': 'x_currency_id'}"/>
                    <button
                        name="%(action_compute_bom_cost_from_components)d"
                        type="action" 
                        icon="fa-arrow-up" 
                        title="Apply BOM Cost" 
                        string="Apply"
                        class="btn btn-link px-0"
                    />
                </div>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="product_category_form_view_inherit">
        <field name="name">product.category.view.form.inherit.construction_developer</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="before">
                <group name="outer">
                    <group name="second">
                        <field name="x_cost_nature" class="oe_inline"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//group[@name='second']" position="before">
                <xpath expr="//group[@name='first']" position="move"/>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="product_template_only_form_view_inherit">
        <field name="name">product.template.view.form.inherit.construction_developer</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="active" eval="True"/>
        <field name="priority">1600</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <label for="x_bom_template_id"/>
                <div>
                    <field name="x_bom_template_id"
                           required="x_bom_available"
                           domain="[('product_tmpl_id.id', '=', id), ('type', '=', 'normal')]"
                           context="{'default_product_tmpl_id': id, 'type': 'normal'}"
                    />
                </div>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="edit_project_inherit">
        <field name="name">project.project.view.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="priority">1600</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action" name="%(action_compute_cost_nature_analysis_report)d"
                        icon="fa-indent"
                        context="{'project_id': id}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Cost Nature</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="x_progress_approver" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="project_update_view_form_inherit">
        <field name="name">project.update.view.form.inherit.construction_developer</field>
        <field name="model">project.update</field>
        <field name="inherit_id" ref="project.project_update_view_form"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page name="remarks" string="Remarks">
                    <field name="x_remark_ids" nolabel="1" context="{
                        'default_x_project_id': project_id,
                        'default_x_update_id': id,
                        'list_view_ref': 'construction_developer.view_x_remark_list_one2many',
                    }"/>
                </page>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="purchase_order_form_inherit">
        <field name="name">purchase.order.view.form.inherit.construction_developer</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="priority">160</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='picking_type_id']" position="after">
                    <field name="x_delivery_site_id" invisible="not x_show_delivery_site" domain="[('location_id', 'child_of', %(stock_location_worksites)d)]"/>
                </xpath>
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="x_delivery_site_name"/>
                </xpath>
            </data>
        </field>
    </record>


    <record model="ir.ui.view" id="view_order_form_inherit">
        <field name="name">sale.order.view.form.inherit.construction_developer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="priority">1600</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//form//header" position="inside">
                <button string="Check Cost Changes"
                        name="%(action_sale_order_line_bom_list_view)d"
                        type="action"
                        invisible="not x_any_sol_bom"
                        />
            </xpath>
            <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action" name="%(action_compute_cost_nature_analysis_report)d"
                        icon="fa-indent"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Cost Nature</span>
                    </div>
                </button>
                <button
                    name="%(server_action_show_wbs)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-tasks"
                    groups="project.group_project_user"
                    invisible="state not in ['sale', 'cancel']"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">WBS</span>
                    </div>
                </button>
                <button
                    name="%(action_show_delivery_progress)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-tasks"
                    groups="project.group_project_user"
                    invisible="state not in ['sale', 'cancel']"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Progress</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook//page[@name='order_lines']//list//field[@name='product_id']" position="before">
                <field name="x_item_number" column_invisible="parent.state != 'sale'" optional="show"/>
            </xpath>
            <xpath expr="//notebook//page[@name='order_lines']//list//field[@name='product_template_id']" position="after">
                <field name="x_bom_id"
                       domain="[('product_tmpl_id', '=', product_template_id)]"
                       optional="hide"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='purchase_price']" position="attributes">
                <attribute name="readonly">x_bom_id</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='route_ids']" position="after">
                <field name="x_product_bom_template_id" column_invisible="True"/>
                <button name="%(action_open_bom)d"
                        type="action"
                        class="btn btn-link"
                        icon="fa-magic"
                        width="1"
                        invisible="not x_product_bom_template_id"
                        string=" "
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="x_ws_location_id" invisible="True"/>
                <button
                    name="%(action_ws_product_location_open)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    context="{'location': x_ws_location_id, 'search_default_real_stock_available': 1, 'search_default_real_stock_negative': 1, 'create': False}"
                    invisible="not x_ws_location_id">
                    <span class="o_stat_text">Stock</span>
                </button>
            </xpath>
        </field>
    </record>


    <record model="ir.ui.view" id="view_move_tree_inherit">
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="model">stock.move</field>
        <field name="name">stock.move.view.list.inherit.construction_developer</field>
        <field name="type">list</field>
        <field name="mode">extension</field>
        <field name="priority">160</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//list" position="attributes">
                    <attribute name="multi_edit">1</attribute>
                </xpath>
                <xpath expr="//field[@name='reference']" position="after">
                    <field name="sale_line_id" optional="show"/>
                </xpath>
            </data>
        </field>
    </record>


    <record model="ir.ui.view" id="view_picking_type_form_inherit">
        <field name="name">stock.picking.type.view.form.inherit.construction_developer</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="priority">1600</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[@name='general']//group[@name='first']//group[2]" position="inside">
                <field name="x_select_dest_on_po" invisible="code != 'incoming'"/>
                <field name="x_source_loc_from_so" invisible="code != 'outgoing'"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_location_route_form_view_inherit">
        <field name="name">stock.route.view.form.inherit.construction_developer</field>
        <field name="model">stock.route</field>
        <field name="inherit_id" ref="stock.stock_location_route_form_view"/>
        <field name="mode">extension</field>
        <field name="type">form</field>
        <field name="priority">1600</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_selectable']" position="after">
                <field name="x_allow_sol_preselect"/>
            </xpath>
        </field>
    </record>
</odoo>
