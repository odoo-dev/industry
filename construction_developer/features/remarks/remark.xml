    <record model="ir.model.fields.selection" id="field_x_remark_x_state_selection_done">
        <field name="name">Done</field>
        <field name="field_id" ref="field_x_remark_x_state"/>
        <field name="value">1_done</field>
    </record>

    <record model="ir.model.fields.selection" id="field_x_remark_x_state_selection_canceled">
        <field name="name">Canceled</field>
        <field name="field_id" ref="field_x_remark_x_state"/>
