<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!--
        This feature adds a cost, margin, and price on the BOM.
        The cost is computed using a standard function totalling the price of the components.
        The margin and price can both be altered and recomputed from one another. 
    -->

    <record model="ir.model.fields" id="field_mrp_bom_x_currency_id">
        <field name="name">x_currency_id</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="field_description">Currency</field>
        <field name="ttype">many2one</field>
        <field name="relation">res.currency</field>
        <field name="related">product_tmpl_id.currency_id</field>
        <field name="store" eval="False"/>
        <field name="readonly" eval="True"/>
    </record>

    <record model="ir.model.fields" id="field_mrp_bom_x_unit_cost">
        <field name="name">x_unit_cost</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="field_description">Unit Cost</field>
        <field name="ttype">monetary</field>
        <field name="currency_field">x_currency_id</field>
        <field name="readonly" eval="True"/>
        <field name="store" eval="False"/>
        <field name="compute"><![CDATA[
for bom in self:
    bom['x_bom_cost'] = product._compute_bom_price(bom) if (product := bom.product_id or bom.product_tmpl_id.product_variant_id) else 0.0
]]></field>
    </record>

    <record model="ir.model.fields" id="field_mrp_bom_x_bom_cost">
        <field name="name">x_bom_cost</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="field_description">BOM Cost</field>
        <field name="ttype">monetary</field>
        <field name="currency_field">x_currency_id</field>
        <field name="store" eval="False"/>
        <field name="readonly" eval="True"/>
        <field name="compute"><![CDATA[
for bom in self:
    bom['x_bom_cost'] = product._compute_bom_price(bom) if (product := bom.product_id or bom.product_tmpl_id.product_variant_id) else 0.0
]]></field>
    </record>


    <!-- 
        Update the cost when a bom is modified.
    -->
    <record model="ir.actions.server" id="action_compute_bom_cost_from_components">
        <field name="name">Construction Developer: Compute BOM Cost</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="state">code</field>
        <field name="code">
for bom in (records or env.context.get('boms', [])):
    bom['x_unit_cost'] = product._compute_bom_price(bom) if (product := bom.product_id or bom.product_tmpl_id.product_variant_id) else 0.0
</field>
    </record>

    <record model="ir.actions.server" id="action_compute_line_bom_cost_from_components">
        <field name="name">Construction Developer: Compute BOM Cost from Lines</field>
        <field name="model_id" ref="mrp.model_mrp_bom_line"/>
        <field name="state">code</field>
        <field name="code">
action = env.ref('construction_developer.action_compute_bom_cost_from_components').with_context(boms=records.bom_id).run()
</field>
    </record>

    <record model="base.automation" id="automation_sol_price_and_cost_on_bom_line_write">
        <field name="name">Construction Developer: Update BOM cost from BOM Line on write</field>
        <field name="model_id" ref="mrp.model_mrp_bom_line"/>
        <field name="trigger">on_create_or_write</field>
        <field name="trigger_field_ids" eval="[(6,0,[ref('mrp.field_mrp_bom_line__product_id'), ref('mrp.field_mrp_bom_line__product_qty'), ref('mrp.field_mrp_bom_line__uom_id')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('construction_developer.action_compute_line_bom_cost_from_components')])]"/>
    </record>

    <record model="base.automation" id="automation_bom_cost_on_bom_lines_write">
        <field name="name">Construction Developer: Update BOM cost on write</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="trigger">on_create_or_write</field>
        <field name="trigger_field_ids" eval="[(6,0,[ref('mrp.field_mrp_bom__bom_line_ids')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('construction_developer.action_compute_bom_cost_from_components')])]"/>
    </record>

    <!-- 
        Update the price and the cost when a bom is selected.
        Must update all 3 at the same time or the annoying margin gets recomputed in between each change
    -->
    <record model="ir.actions.server" id="action_update_sol_cost_price_margin_on_x_bom_id_write">
        <field name="name">Construction Developer: Update SOL Cost from BOM</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="state">code</field>
        <field name="code">
for sol in records: record.write({'margin_percent': sol.margin_percent, 'purchase_price': sol.x_bom_id.x_unit_cost, 'price_unit': sol.x_bom_id.x_unit_cost / div if (div := (1 - sol.margin_percent)) else 0})
</field>
    </record>

    <record model="base.automation" id="automation_sol_price_and_cost_on_x_bom_id_write">
        <field name="name">Construction Developer: Update SOL price and cost from BOM on set</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[('x_bom_id', '!=', False)]</field>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('field_sale_order_line_x_bom_id')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_update_sol_cost_price_margin_on_x_bom_id_write')])]"/>
    </record>


    <!-- 
        Update the price and the cost on the SOL when a bom is saved.
        Must update all 3 at the same time or the annoying margin gets recomputed in between each change
    -->
    <record model="ir.actions.server" id="action_update_sol_cost_price_margin_from_bom">
        <field name="name">Construction Developer: Update SOL Cost from BOM</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="state">code</field>
        <field name="code">
for record in records: (sol := record.x_original_sol_id).write({'margin_percent': sol.margin_percent, 'purchase_price': record.x_unit_cost, 'price_unit': record.x_unit_cost / div if (div := (1 - sol.margin_percent)) else 0})
</field>
    </record>

    <record model="base.automation" id="automation_sol_price_and_cost_on_bom_write">
        <field name="name">Construction Developer: Update SOL price and cost from BOM on write</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[('x_original_sol_id', '!=', False)]</field>
        <field name="trigger_field_ids" eval="[(6,0,[ref('field_mrp_bom_x_unit_cost')])]"/>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_update_sol_cost_price_margin_from_bom')])]"/>
    </record>
</odoo>
