  <record id="default_kanban_view__46ce094b-c0f1-4768-8d20-9144a5b341b7" model="ir.ui.view">
    <field name="arch" type="xml">
      <kanban default_group_by="x_stage_id" default_order="x_priority desc, x_sequence asc, id desc" highlight_color="x_color">
        <field name="x_color"/>
        <progressbar field="x_kanban_state" colors="{&quot;normal&quot;: &quot;200&quot;, &quot;done&quot;: &quot;success&quot;, &quot;blocked&quot;: &quot;danger&quot;}"/>
        <templates>
          <t t-name="menu">
            <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
            <field widget="kanban_color_picker" name="x_color"/>
          </t>
          <t t-name="card" class="flex-row">
            <main>
              <div name="studio_auto_kanban_header" class="d-flex">
                <field name="x_priority" widget="boolean_favorite" nolabel="1"/>
                <field name="display_name" class="h5"/>
              </div>
              <div name="studio_auto_kanban_body">
                <field name="x_tag_ids" options="{'color_field': 'x_color'}"/>
              </div>
              <footer>
                <div class="ms-auto d-flex align-items-center">
                  <field name="x_kanban_state" widget="state_selection"/>
                  <field class="ms-1" name="x_user_id" widget="kanban.many2one_avatar_user"/>
                </div>
              </footer>
            </main>
          </t>
        </templates>
      </kanban>
    </field>
    <field name="model">x_freight</field>
    <field name="active" eval="True"/>
    <field name="name">Default kanban view for x_freight</field>
    <field name="type">kanban</field>
  </record>
