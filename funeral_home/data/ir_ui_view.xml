<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="sale_order_form_funeral" model="ir.ui.view">
        <field name="name">sale.order.form.funeral</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="priority">160</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Funeral" name="x_funeral">
                    <group>
                        <group string="Deceased" name="x_funeral_deceased">
                            <field name="x_deceased_name"/>
                            <field name="x_deceased_birth_date"/>
                            <field name="x_deceased_death_date"/>
                            <field name="x_deceased_death_place"/>
                        </group>
                        <group string="Cremation" name="x_funeral_cremation">
                            <field name="x_crematorium_id" context="{'default_x_is_crematorium': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_form_funeral" model="ir.ui.view">
        <field name="name">res.partner.form.funeral</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="priority">160</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="x_is_crematorium" invisible="parent_id"/>
            </xpath>
        </field>
    </record>

    <record id="res_company_form_funeral" model="ir.ui.view">
        <field name="name">res.company.form.funeral</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="mode">extension</field>
        <field name="active" eval="True"/>
        <field name="priority">160</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <field name="country_code" invisible="1"/>
                <group string="Funeral Home" name="x_funeral_region" invisible="country_code != 'BE'">
                    <field name="x_funeral_region"/>
                    <field name="x_funeral_region_override"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
