<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
    <function model="website" name="configurator_apply" context="{'website_id': ref('base.default_website')}">
        <value name="industry_id" eval="4629"/>
        <value name="industry_name">garage &amp; auto repair</value>
        <value name="theme_name" eval="'theme_notes' if ref('base.module_theme_notes', raise_if_not_found=False) else 'theme_default'"/>
        <value name="selected_palette">default-1</value>
        <value name="is_dark_palette" eval="False"/>
        <value name="website_type">business</value>
        <value name="website_purpose">schedule_appointments</value>
        <value name="logo_attachment_id" eval="False"/>
        <value name="skip_ai" eval="False"/>
    </function>

    <function model="ir.ui.view" name="write">
        <value eval="[ref('ir_ui_view_3403')]"/>
        <value model="ir.ui.view" eval="{'arch': obj().env.ref('garage_auto_repair.ir_ui_view_3403').arch.replace(
            '*intervention_project*', str(obj().env.ref('garage_auto_repair.project_project_1').id)
        )}"/>
    </function>
    <function model="website.menu" name="write">
        <value model="website.menu" eval="obj().search([
            ('website_id', '=', ref('base.default_website')),
            ('url', '=', '/appointment'),
        ], limit=1).id"/>
        <value eval="{'name': 'Schedule Appointment', 'page_id': ref('website_page_6')}"/>
    </function>

    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().search([('key', '=', 'website.snippets_cta'), ('website_id', '=', ref('base.default_website'))], limit=1).ids"/>
        <value model="ir.ui.view" eval="{'arch': obj().search([('key', '=', 'website.snippets_cta'), ('website_id', '=', ref('base.default_website'))], limit=1).arch.replace(
            '>/appointment&lt;', '>/schedule-appointment&lt;'
        )} if obj().search_count([('key', '=', 'website.snippets_cta'), ('website_id', '=', ref('base.default_website'))]) else {}"/>
    </function>
    <function model="ir.ui.view" name="write">
        <value model="ir.ui.view" eval="obj().search([('key', '=', 'website.header_call_to_action'), ('website_id', '=', ref('base.default_website'))], limit=1).ids"/>
        <value model="ir.ui.view" eval="{'arch': obj().search([('key', '=', 'website.header_call_to_action'), ('website_id', '=', ref('base.default_website'))], limit=1).arch.replace(
            'href=&quot;/appointment&quot;', 'href=&quot;/schedule-appointment&quot;'
        )} if obj().search_count([('key', '=', 'website.header_call_to_action'), ('website_id', '=', ref('base.default_website'))]) else {}"/>
    </function>
</odoo>
