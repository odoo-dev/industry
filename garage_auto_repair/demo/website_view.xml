<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="ir_ui_view_3403" model="ir.ui.view">
    <field name="arch" type="xml">
      <t t-name="website.schedule-appointment">
        <t t-call="website.layout">
          <div id="wrap" class="oe_structure oe_empty">
            <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
              <div class="container s_allow_columns">
                <h2 style="text-align: center;">Schedule Appointment</h2>
              </div>
            </section>
            <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
              <div class="container s_allow_columns">
                <p>
                  <span class="h4-fs">Fill out the form below to request a service. Once received, our team will review your needs and send you a personalized booking link to select a time that works best for you.</span>
                </p>
                <p>
                  <span class="h4-fs">&amp;nbsp;Feel free to drop off your vehicle earlier if needed!</span>
                </p>
              </div>
            </section>
            <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
              <div class="s_allow_columns container">
                <h2 style="text-align: left;">Service Request</h2>
              </div>
            </section>
            <section class="s_website_form pt16 pb16 o_colored_level" data-vcss="001" data-snippet="s_website_form">
              <div class="container">
                <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name="project.task" data-success-mode="redirect" data-success-page="/your-task-has-been-submitted">
                  <div class="s_website_form_rows row s_col_no_bgcolor">
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 undefined s_website_form_required" data-type="char" data-translated-name="Full Name">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="omvg7je1wp5">
                          <span class="s_website_form_label_content">Full Name</span>
                          <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                          <input class="form-control s_website_form_input" type="text" name="partner_name" required="1" data-fill-with="name" id="omvg7je1wp5"/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom" data-type="boolean" data-translated-name="Custom Text">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-sm-auto s_website_form_label" style="width: 200px" for="ocm45vem9ix7">
                          <span class="s_website_form_label_content">Existing customer?</span>
                        </label>
                        <div class="col-sm">
                          <div class="form-check">
                            <input type="checkbox" value="Yes" class="s_website_form_input form-check-input" name="Existing customer?" id="ocm45vem9ix7" data-fill-with="undefined"/>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required" data-type="char" data-translated-name="Custom Text">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="og8fpf7hvsmw">
                          <span class="s_website_form_label_content">Plate Number</span>
                          <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                          <input class="form-control s_website_form_input" type="text" name="Plate Number" id="og8fpf7hvsmw" required=""/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required undefined s_website_form_field_hidden_if d-none" data-type="tel" data-translated-name="Phone Number" data-visibility-dependency="Existing customer?" data-visibility-condition="Yes" data-visibility-comparator="!selected">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ofkn72opafzn">
                          <span class="s_website_form_label_content">Phone Number</span>
                          <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                          <input class="form-control s_website_form_input" type="tel" name="partner_phone" data-fill-with="phone" id="ofkn72opafzn" required=""/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required s_website_form_field_hidden_if d-none" data-type="char" data-translated-name="Custom Text" data-visibility-dependency="Existing customer?" data-visibility-condition="Yes" data-visibility-comparator="!selected">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="o5bc1i53y16a">
                          <span class="s_website_form_label_content">Vehicle Model</span>
                          <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                          <input class="form-control s_website_form_input" type="text" name="Vehicle Model" id="o5bc1i53y16a" required="" placeholder="BMW/530e"/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 undefined s_website_form_custom s_website_form_required" data-type="email" data-translated-name="Email Address">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="op9e51i93cqo">
                          <span class="s_website_form_label_content">Email Address</span>
                          <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                          <input class="form-control s_website_form_input" type="email" name="email_from" required="1" data-fill-with="email" id="op9e51i93cqo"/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 undefined" data-type="char" data-translated-name="Company Name">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="oynfbmueeup8">
                          <span class="s_website_form_label_content">Company Name</span>
                        </label>
                        <div class="col-sm">
                          <input class="form-control s_website_form_input" type="text" name="partner_company_name" data-fill-with="parent_name" id="oynfbmueeup8"/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required undefined" data-type="char" data-translated-name="Message Subject">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="oxlaz5ixzqvh">
                          <span class="s_website_form_label_content">Message Subject</span>
                          <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                          <input class="form-control s_website_form_input" type="text" name="name" required="" id="oxlaz5ixzqvh" placeholder="General Maintenance, Tyre Service, Engine Diagnostics, Emergency Repair, Other."/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 undefined s_website_form_required" data-type="text" data-translated-name="Ask Your Question">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="owqm1g5d7cja">
                          <span class="s_website_form_label_content">Describe the Issue</span>
                          <span class="s_website_form_mark"> *</span>
                        </label>
                        <div class="col-sm">
                          <textarea class="form-control s_website_form_input" name="description" required="1" id="owqm1g5d7cja" rows="3"/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_custom undefined" data-type="binary" data-translated-name="Field">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="oaok1shc48n">
                          <span class="s_website_form_label_content">Picture</span>
                        </label>
                        <div class="col-sm">
                          <input type="file" class="form-control s_website_form_input" name="Picture" id="oaok1shc48n" data-max-files-number="1" data-max-file-size="64"/>
                        </div>
                      </div>
                    </div>
                    <div data-name="Field" class="s_website_form_field mb-3 col-12 undefined s_website_form_dnone">
                      <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px">
                          <span class="s_website_form_label_content"/>
                        </label>
                        <div class="col-sm">
                          <input type="hidden" class="form-control s_website_form_input" name="project_id" value="*intervention_project*"/>
                        </div>
                      </div>
                    </div>
                    <div class="mb-0 py-2 col-12 s_website_form_submit text-end s_website_form_no_submit_label" data-name="Submit Button">
                      <div style="width: 200px;" class="s_website_form_label"/>
                      <span id="s_website_form_result" class="me-2 small text-danger"/>
                      <a href="#" role="button" class="btn btn-primary s_website_form_send">Request Appointment</a>
                    </div>
                  </div>
                </form>
              </div>
            </section>
          </div>
        </t>
      </t>
    </field>
    <field name="key">website.schedule-appointment</field>
    <field name="name">Schedule Appointment</field>
    <field name="type">qweb</field>
    <field name="website_id" ref="base.default_website"/>
  </record>
</odoo>
