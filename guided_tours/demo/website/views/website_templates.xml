<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - footer_copyright_company_name</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
                    Copyright © Globe Guided Tours
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="template_footer_descriptive" model="ir.ui.view">
        <field name="name">Custom - Descriptive</field>
        <field name="key">website.template_footer_descriptive</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block pb32" data-snippet="s_text_block" data-name="Text">
                        <div class="s_allow_columns container">
                            <div class="row">
                                <div class="col-lg-12 pt48 pb24 o_colored_level">
                                    <h4><b>Designed</b> for guided tour</h4>
                                </div>
                                <div class="col-lg-5 o_colored_level">
                                    <p>We are a team of travel enthusiasts dedicated to enriching lives through unforgettable journeys. We curate exceptional tours to create lasting memories for our travelers. Our experiences cater to adventurers and leisure seekers alike.</p>
                                </div>
                                <div class="col-lg-3 offset-lg-1 o_colored_level">
                                    <p><span style="font-size: 18px;">
                                            <strong>Globe Guided Tours</strong>
                                        </span><br/>Guided Tour Street <br/>1000 Brussels <br/>Belgium</p>
                                </div>
                                <div class="col-lg-3 o_colored_level">
                                    <ul class="list-unstyled mb-2">
                                        <li>
                                            <i class="fa fa-phone fa-fw me-2"/>
                                            <a href="tel:+3226168002" class="o_translate_inline">
                                                <span class="text-o-color-3">+32 2 616 80 02</span>
                                            </a>
                                        </li>
                                        <li>
                                            <i class="fa fa-envelope fa-fw me-2"/>
                                            <span>
                                                <a href="mailto:hello@globe-guided-tours.com">
                                                    <span class="text-o-color-3">hello@globe-guided-tours.com</span>
                                                </a>
                                            </span>
                                        </li>
                                    </ul>
                                    <div class="s_social_media text-start o_not_editable no_icon_color" data-snippet="s_social_media" data-name="Social Media">
                                        <h5 class="s_social_media_title d-none">Follow us</h5>
                                        <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank">
                                            <i class="fa fa-facebook m-1 o_editable_media o_sm_custom_size rounded-empty-circle shadow-sm" style="--fa-icon-size: 2.75rem;"/>
                                        </a>
                                        <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank">
                                            <i class="fa fa-twitter m-1 o_editable_media o_sm_custom_size rounded-empty-circle shadow-sm" style="--fa-icon-size: 2.75rem;"/>
                                        </a>
                                        <a href="/website/social/instagram" class="s_social_media_instagram" target="_blank">
                                            <i class="fa fa-instagram m-1 o_editable_media o_sm_custom_size rounded-empty-circle shadow-sm" style="--fa-icon-size: 2.75rem;"/>
                                        </a>
                                        <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank">
                                            <i class="fa fa-linkedin m-1 o_editable_media o_sm_custom_size rounded-empty-circle shadow-sm" style="--fa-icon-size: 2.75rem;"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="header_call_to_action" model="ir.ui.view">
        <field name="name">Header Call to Action</field>
        <field name="key">guided_tours.header_call_to_action</field>
        <field name="inherit_id" ref="website.placeholder_header_call_to_action"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="." position="inside">
                <li t-attf-class="#{_item_class}">
                    <div t-attf-class="oe_structure oe_structure_solo #{_div_class}">
                        <section class="oe_unremovable oe_unmovable s_text_block o_colored_level" data-snippet="s_text_block" data-name="Text">
                            <div class="container">
                                <a href="/event" class="oe_unremovable btn btn-secondary">Book a Tour</a>
                            </div>
                        </section>
                    </div>
                </li>
            </xpath>
        </field>
    </record>
    <record id="event_navbar" model="ir.ui.view">
        <field name="name">Event Navbar</field>
        <field name="key">guided_tours.navbar</field>
        <field name="inherit_id" ref="website_event.navbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//li[@t-if='event.header_visible']//a[@href='/event']" position="replace">
                <a href="/event" title="Back to All Guided Tours">All Guided Tours</a>
            </xpath>
        </field>
    </record>
    <record id="event_index_topbar" model="ir.ui.view">
        <field name="name">Topbar</field>
        <field name="key">guided_tours.index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('o_wevent_index_topbar_filters')]/div[hasclass('flex-grow-1')]/h1" position="replace">
                <h1 class="mb-0 h4-fs">Guided Tours</h1>
            </xpath>
        </field>
    </record>
    <record id="appointment_index_topbar" model="ir.ui.view">
        <field name="name">Topbar</field>
        <field name="key">guided_tours.website_calendar_index_topbar</field>
        <field name="inherit_id" ref="website_appointment.website_calendar_index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('d-flex')]/div[hasclass('flex-grow-1')]/h1" position="replace">
                <h1 class="h4 mb-0">Choose your destination</h1>
            </xpath>
        </field>
    </record>
    <record id="event_index" model="ir.ui.view">
        <field name="name">Guided Tours</field>
        <field name="key">guided_tours.index</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_we_index_2']" position="replace">
                <div id="oe_structure_we_index_2" class="oe_structure oe_empty">
                    <section class="s_text_block o_colored_level pt96 o_cc o_cc3 pb256" data-snippet="s_text_block" data-name="Text" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Nature/03&quot;,&quot;colors&quot;:{&quot;c1&quot;:&quot;o-color-5&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;,&quot;selectedColor&quot;:true}" style="position: relative;">
                        <div class="o_we_shape o_html_builder_Nature_03" style="background-image: url(&quot;/html_editor/shape/html_builder%2FNature%2F03.svg?c1=%231B1319&quot;);"/>
                        <div class="s_allow_columns o_container_small">
                            <h2>
                                <span class="h3-fs">
                                    <strong>Join Our Guided Group Tours — Discover More Together</strong>
                                </span>
                            </h2>
                            <p>
                                <br/>
                            </p>
                            <p>Experience the world like never before with our expertly led group tours through <strong>Sidney, New-York, Bali, and Rome</strong>. Whether you're traveling solo, with friends, or as part of a group, our guided tours offer the perfect balance of storytelling, sightseeing, and shared discovery.</p>
                            <p>Walk alongside fellow travelers as our passionate guides bring each city to life, from medieval alleyways and majestic cathedrals to modern neighborhoods full of local flavor. Our groups are <strong>small enough to stay personal</strong>, but <strong>big enough to share laughs and moments</strong> you'll remember long after the tour ends.</p>
                            <h3>
                                <span class="h4-fs">Expect:</span>
                            </h3>
                            <p>
                                <br/>
                            </p>
                            <ul class="s_icon_list" data-snippet="s_icon_list" data-name="Icon List">
                                <li>Friendly, knowledgeable guides who love questions</li>
                                <li>Carefully curated routes with iconic sights and hidden corners</li>
                                <li>A relaxed pace with time for photos, fun facts, and local tips</li>
                                <li>Great company, because exploring is better together</li>
                            </ul>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
