<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="ir_ui_view_541" model="ir.ui.view">
    <field name="arch" type="xml">
      <t name="Homepage" t-name="website.homepage">
        <t t-call="website.layout">
          <t t-set="pageName" t-value="'homepage'"/>
          <div id="wrap" class="oe_structure">
            <section class="s_discovery pt136 pb136 o_cc o_cc5" data-snippet="s_discovery">
              <div class="container" style="text-align: center;">
                <h1 style="text-align: center">
                  <strong>We are GuitarStudio.</strong>
                </h1>
                <p class="lead" style="text-align: center;">Experience captivating performances where every note resonates with energy and passion. My concerts are crafted to deliver unforgettable moments that connect deeply with the audience.<br/><br/></p>
                <p style="text-align: center;">
                  <a class="btn btn-lg btn-primary" href="/event">Upcoming Concerts</a>
                </p>
              </div>
            </section>
            <section class="s_parallax parallax s_parallax_is_fixed bg-black-50 o_half_screen_height pt48 pb48" data-scroll-background-ratio="3" data-snippet="s_parallax">
              <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 75%;"/>
              <div class="o_we_bg_filter bg-black-25"/>
              <div class="oe_structure oe_empty"/>
            </section>
            <section class="s_text_block o_cc o_cc5 pt96 pb96" data-snippet="s_text_block">
              <div class="container s_allow_columns">
                <div class="row">
                  <div class="col-12 col-lg-10">
                    <h6>
                      <strong>
                        <font class="text-o-color-1">MY PASSION</font>
                      </strong>
                    </h6>
                    <p>
                      <span class="h3-fs">My passion for guitar drives every performance, infusing each concert with raw emotion and dedication. Every note I play is an expression of my journey, aiming to connect deeply with listeners and create memorable musical experiences that resonate long after the last chord.
                      </span>
                    </p>
                  </div>
                </div>
              </div>
            </section>
            <section class="s_key_images pt72 pb72 o_cc o_cc5" data-snippet="s_key_images">
              <div class="container">
                <div class="row s_nb_column_fixed">
                  <div class="col-lg-12 pb32">
                    <h2 style="text-align: center;">My performances</h2>
                    <p class="lead" style="text-align: center;">Some of the latest concert I had the pleasure to conduct</p>
                  </div>
                  <div class="col-6 col-lg-6 o_animate o_animated o_anim_from_left o_anim_slide_in" style="--wanim-intensity: 3;animation-name: o_anim_slide_in_left;animation-play-state: running">
                    <p>
                      <img src="/web/image/website.s_key_images_default_image_1" class="img img-fluid rounded" alt="" style="width: 100% !important;" loading="lazy"/>
                    </p>
                    <h3>
                      <font class="text-o-color-1">Guitar Skills Showcase</font>
                    </h3>
                    <p>2021</p>
                  </div>
                  <div class="col-6 col-lg-6 o_animate o_animated o_anim_from_right o_anim_slide_in" style="--wanim-intensity: 3;animation-delay: 0.3s;animation-name: o_anim_slide_in_right;animation-play-state: running">
                    <p>
                      <img src="/web/image/website.s_key_images_default_image_2" class="img img-fluid rounded" alt="" style="width: 100% !important;" loading="lazy"/>
                    </p>
                    <h3>
                      <font class="text-o-color-1">Guitar Technique Enhancement</font>
                    </h3>
                    <p>2022</p>
                  </div>
                  <div class="col-6 col-lg-6 pt48 o_animate o_animated o_anim_from_left o_anim_slide_in" style="--wanim-intensity: 3;animation-name: o_anim_slide_in_left;animation-play-state: running">
                    <p>
                      <img src="/web/image/website.s_key_images_default_image_3" class="img img-fluid rounded" alt="" style="width: 100% !important;" loading="lazy"/>
                    </p>
                    <h3>
                      <font class="text-o-color-1">Acoustic Guitar Workshop</font>
                    </h3>
                    <p>2023</p>
                  </div>
                  <div class="col-6 col-lg-6 pt48 o_animate o_animated o_anim_from_right o_anim_slide_in" style="--wanim-intensity: 3;animation-delay: 0.3s;animation-name: o_anim_slide_in_right;animation-play-state: running">
                    <p>
                      <img src="/web/image/website.s_key_images_default_image_4" class="img img-fluid rounded" alt="" style="width: 100% !important;" loading="lazy"/>
                    </p>
                    <h3>
                      <font class="text-o-color-1">Guitar Mastery Program</font>
                    </h3>
                    <p>2019</p>
                  </div>
                </div>
              </div>
            </section>
            <section class="s_image_text_overlap pt64 pb64 o_cc o_cc5" data-snippet="s_image_text_overlap">
              <div class="container">
                <div class="row o_grid_mode" data-row-count="9">
                  <div class="o_grid_item o_grid_item_image order-lg-0 g-col-lg-7 g-height-9 col-lg-7" style="grid-area: 1 / 1 / 10 / 8; --grid-item-padding-y: 0; z-index: 1; order: 2;">
                    <img src="/web/image/website.s_picture_default_image" class="img img-fluid mx-auto rounded" alt="" loading="lazy"/>
                  </div>
                  <div class="o_grid_item order-lg-0 g-col-lg-6 g-height-7 col-lg-6 o_cc rounded o_cc4" style="grid-area: 2 / 7 / 9 / 13; --grid-item-padding-y: 56px; --grid-item-padding-x: 40px; z-index: 2; order: 1;">
                    <h3>My story began with a passion for music. From a small musicians, I've grown into a studio focused on nurturing talent and building lasting student relationships.</h3>
                  </div>
                </div>
              </div>
            </section>
            <section class="s_numbers o_cc pt80 pb80 o_cc5" data-snippet="s_numbers">
              <div class="container">
                <div class="row">
                  <div class="col-lg-4 pt24 pb24">
                    <p class="lead" style="text-align: center;">
                      <span class="s_number display-1-fs">100+</span>
                      <br/>
                      <span class="h5-fs">Concerts last year</span>
                    </p>
                  </div>
                  <div class="col-lg-4 pt24 pb24" style="box-shadow: var(--o-border-color) 1px 0px 0px 0px inset !important;">
                    <p class="lead" style="text-align: center;">
                      <span class="s_number display-1-fs">20</span>
                      <br/>
                      <span class="h5-fs">Concerts this year</span>
                    </p>
                  </div>
                  <div class="col-lg-4 pt24 pb24" style="box-shadow: var(--o-border-color) 1px 0px 0px 0px inset !important;">
                    <p class="lead" style="text-align: center;">
                      <span class="s_number display-1-fs">4.8</span>
                      <br/>
                      <span class="h5-fs">Customer ratings</span>
                    </p>
                  </div>
                </div>
              </div>
            </section>
            <section class="s_cta_box pt80 pb80 o_cc o_cc5" data-snippet="s_cta_box">
              <div class="container">
                <div class="s_card o_card_img_horizontal flex-lg-row-reverse card o_cc o_cc5" data-snippet="s_card" data-vxml="001" data-name="Card" style="--card-spacer-x: 64px;--card-spacer-y: 64px;border-width: 0px !important;background-image: linear-gradient(90deg, var(--o-color-1) 0%, var(--o-color-5) 100%)">
                  <div class="card-body" style="text-align: center">
                    <h2 class="card-title" style="text-align: center;">Interested in guitar concert?</h2>
                    <p class="card-text" style="text-align: center;">Do not hesitate to book a place!<br/><br/></p>
                    <a class="btn btn-lg btn-primary" href="/event">Book a place.</a>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </t>
      </t>
    </field>
    <field name="key">guitarist.website.homepage</field>
    <field name="name">Home</field>
    <field name="type">qweb</field>
    <field name="website_id" ref="website.default_website"/>
  </record>
  <function model="ir.ui.view" name="write">
    <value model="ir.ui.view" eval="obj().env['website'].with_context(website_id=obj().env.ref('website.default_website').id).viewref('website.homepage').id"/>
    <value model="ir.ui.view" eval="{'arch': obj().env.ref('guitarist.ir_ui_view_541').arch}"/>
  </function>
</odoo>
