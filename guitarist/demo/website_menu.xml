<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <function model="website.menu" name="unlink">
    <value model="website.menu" eval="obj().search([('website_id', '=', ref('website.default_website')), ('url', '=', '/default-main-menu')]).id"/>
  </function>
  <record id="website.main_menu" model="website.menu" forcecreate="1">
    <field name="name">Default Main Menu</field>
    <field name="url">/default-main-menu</field>
    <field name="sequence" eval="False"/>
  </record>
  <record id="website_menu_4" model="website.menu">
    <field name="name">Top Menu for Website 1</field>
    <field name="url">/default-main-menu</field>
    <field name="sequence" eval="False"/>
    <field name="website_id" ref="website.default_website"/>
  </record>
  <record id="website.menu_home" model="website.menu" forcecreate="1">
    <field name="name">Home</field>
    <field name="url">/</field>
    <field name="page_id" ref="website.homepage_page"/>
    <field name="sequence">10</field>
    <field name="parent_id" ref="website.main_menu"/>
  </record>
  <record id="website_menu_5" model="website.menu">
    <field name="name">Home</field>
    <field name="url">/</field>
    <field name="page_id" ref="website_page_4"/>
    <field name="sequence">10</field>
    <field name="website_id" ref="website.default_website"/>
    <field name="parent_id" ref="website_menu_4"/>
  </record>
  <record id="website_menu_7" model="website.menu">
    <field name="name">Shop</field>
    <field name="url">/shop</field>
    <field name="sequence">15</field>
    <field name="website_id" ref="website.default_website"/>
    <field name="parent_id" ref="website_menu_4"/>
  </record>
  <record id="website_sale.menu_shop" model="website.menu" forcecreate="1">
    <field name="name">Shop</field>
    <field name="url">/shop</field>
    <field name="sequence">20</field>
    <field name="parent_id" ref="website.main_menu"/>
  </record>
  <record id="website_menu_11" model="website.menu">
    <field name="name">Events</field>
    <field name="url">/event</field>
    <field name="sequence">20</field>
    <field name="website_id" ref="website.default_website"/>
    <field name="parent_id" ref="website_menu_4"/>
  </record>
  <record id="website_event.menu_events" model="website.menu" forcecreate="1">
    <field name="name">Events</field>
    <field name="url">/event</field>
    <field name="sequence">30</field>
    <field name="parent_id" ref="website.main_menu"/>
  </record>
  <record id="website_menu_9" model="website.menu">
    <field name="name">Appointment</field>
    <field name="url">/appointment</field>
    <field name="sequence">55</field>
    <field name="website_id" ref="website.default_website"/>
    <field name="parent_id" ref="website_menu_4"/>
  </record>
  <record id="website_appointment.menu_appointment" model="website.menu" forcecreate="1">
    <field name="name">Appointment</field>
    <field name="url">/appointment</field>
    <field name="sequence">55</field>
    <field name="parent_id" ref="website.main_menu"/>
  </record>
  <record id="website.menu_contactus" model="website.menu" forcecreate="1">
    <field name="name">Contact us</field>
    <field name="url">/contactus</field>
    <field name="page_id" ref="website.contactus_page"/>
    <field name="parent_id" ref="website.main_menu"/>
  </record>
  <record id="website_menu_6" model="website.menu">
    <field name="name">Contact us</field>
    <field name="url">/contactus</field>
    <field name="page_id" ref="website.contactus_page"/>
    <field name="website_id" ref="website.default_website"/>
    <field name="parent_id" ref="website_menu_4"/>
  </record>
</odoo>
