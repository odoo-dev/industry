<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <function model="ir.module.module" name="_theme_load" context="{'apply_new_theme': True}">
    <value model="ir.module.module" eval="obj().env['ir.module.module'].search([('name', '=', 'theme_nano')]).ids"/>
    <value model="ir.module.module" eval="obj().env.ref('website.default_website')"/>
  </function>
  <function name="make_scss_customization" model="web_editor.assets" context="{'website_id': ref('website.default_website')}">
    <value eval="'/website/static/src/scss/options/colors/user_color_palette.scss'"/>
    <value eval="{'o-color-1': '#FFDFDE','o-color-2': '#6A7BA2','o-color-3': '#F5F0F0','o-color-4': '#FFFFFF','o-color-5': '#2E1514', 'menu': 1}"/>
</function>
  <function model="website.menu" name="unlink">
    <value model="website.menu" eval="obj().search([
        ('website_id', '=', ref('website.default_website')),
        ('url', '=', '/appointment'),
    ]).id"/>
</function>
<function model="website.menu" name="unlink">
  <value model="website.menu" eval="obj().search([
      ('website_id', '=', ref('website.default_website')),
      ('url', '=', '/contactus'),
  ]).id"/>
</function>
</odoo>
