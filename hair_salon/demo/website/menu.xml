<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Website menus - parent_id via search on root (url=#) -->
        <!-- Default menu (rename/reorder): Home -->
        <function name="write" model="website.menu">
            <value model="website.menu" search="[('url', '=', '/'), ('website_id', '=', ref('hair_salon.website_industry'))]"/>
            <value eval="{'name': 'Home', 'sequence': 10, 'is_visible': True}"/>
        </function>
        <!-- Default menu (rename/reorder): Contact us -->
        <function name="write" model="website.menu">
            <value model="website.menu" search="[('url', '=', '/contactus'), ('website_id', '=', ref('hair_salon.website_industry'))]"/>
            <value eval="{'name': 'Contact us', 'sequence': 60, 'is_visible': True}"/>
        </function>
        <!-- Default menu (rename/reorder): Appointment -->
        <function name="write" model="website.menu">
            <value model="website.menu" search="[('url', '=', '/appointment'), ('website_id', '=', ref('hair_salon.website_industry'))]"/>
            <value eval="{'name': 'Appointment', 'sequence': 55, 'is_visible': True}"/>
        </function>
    </data>
</odoo>
