<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Remove default menus -->
    <delete model="website.menu" search="[('url', 'in', ['/shop', '/appointment']), ('website_id', '=', ref('website.default_website'))]"/>
    <!-- Website menus - parent_id via search on root (url=#) -->
    <!-- Custom menu: Rooms -->
    <record id="menu_rooms" model="website.menu">
        <field name="name">Rooms</field>
        <field name="url">/shop</field>
        <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" eval="20"/>
        <field name="is_visible" eval="True"/>
    </record>
    <record id="menu_contactus" model="website.menu">
        <field name="name">Contact us</field>
        <field name="url">/contactus</field>
        <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" eval="30"/>
        <field name="is_visible" eval="True"/>
    </record>
</odoo>
