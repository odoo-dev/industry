<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Website menus - parent_id via search on root (url=#) -->
    <!-- Custom menu: Home -->
    <record id="menu_home" model="website.menu">
      <field name="name">Home</field>
      <field name="url">/</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', 1)]"/>
      <field name="website_id" ref="website.default_website"/>
      <field name="sequence" eval="10"/>
      <field name="page_id" ref="website_hotel.page_home"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Custom menu: Contact us -->
    <record id="menu_contactus" model="website.menu">
      <field name="name">Contact us</field>
      <field name="url">/contactus</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', 1)]"/>
      <field name="website_id" ref="website.default_website"/>
      <field name="sequence" eval="2"/>
      <field name="page_id" ref="website_hotel.page_contactus"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Custom menu: Rooms -->
    <record id="menu_rooms" model="website.menu">
      <field name="name">Rooms</field>
      <field name="url">/shop</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', 1)]"/>
      <field name="website_id" ref="website.default_website"/>
      <field name="sequence" eval="1"/>
      <field name="is_visible" eval="True"/>
    </record>
  </data>
</odoo>
