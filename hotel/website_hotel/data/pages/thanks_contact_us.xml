<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="page_thanks_contact_us" model="website.page">
        <field name="name">Thanks (Contact us)</field>
        <field name="key">website_hotel.page_thanks_contact_us</field>
        <field name="url">/contactus-thank-you</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t name="Thanks (Contact us)" t-name="website_hotel.page_thanks_contact_us">
                <t t-call="website.layout">
                    <div class="oe_structure oe_empty" id="wrap">
                        <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-6 offset-lg-1 text-center">
                                        <div class="d-inline-block mx-auto p-4">
                                            <h1 class="fw-bolder">Thank You!</h1>
                                            <p class="lead mb-0">Your message has been sent.</p>
                                            <p class="lead">We will get back to you shortly.</p>
                                            <a href="/">Go to Homepage</a>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 offset-lg-1">
                                        <h2>My Company</h2>
                                        <ul class="list-unstyled mb-0 ps-2">
                                            <li><span class="o_force_ltr">3575 Fake Buena Vista Avenue</span></li>
                                            <li><span class="o_force_ltr">+1 555-555-5556</span></li>
                                            <li><span>info@yourcompany.example.com</span></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input class="js_plausible_push" data-event-name="Lead Generation" data-event-params='{"CTA": "Contact Us"}' t-if="website.plausible_shared_key" type="hidden"/>
                </t>
            </t>
        </field>
    </record>
</odoo>
