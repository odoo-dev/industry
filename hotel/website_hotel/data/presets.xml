<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Deactivate fragile view (xpath breaks on some themes) -->
    <record id="website.footer_copyright_company_name" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <!---->
    <!-- Disable default homepage/contactus views (our pages use their own views) -->
    <record id="website.homepage" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website.contactus" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <!---->
    <!-- Presets des vues COW (active uniquement si != valeur native) -->
    <record id="website_sale.carousel_product_indicators_bottom" model="ir.ui.view">
      <field name="active" eval="True"/>
    </record>
    <record id="website_sale.carousel_product_indicators_left" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website_sale.cta_wrapper_boxed" model="ir.ui.view">
      <field name="active" eval="True"/>
    </record>
    <record id="website_sale.floating_bar" model="ir.ui.view">
      <field name="active" eval="True"/>
    </record>
    <record id="website_sale.products_attributes_collapsible" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website_sale.products_categories_list_collapsible" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website.footer_custom" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website.header_call_to_action" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website.header_search_box" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website.header_text_element" model="ir.ui.view">
      <field name="active" eval="False"/>
    </record>
    <record id="website.template_footer_minimalist" model="ir.ui.view">
      <field name="active" eval="True"/>
    </record>
    <!---->
    <!-- Remove default menus -->
    <delete model="website.menu" search="[('url', 'in', ['/', '/contactus', '/contact-us']), ('website_id', '=', ref('website.default_website'))]"/>
    <!---->
    <!-- Remove default pages (replaced by our pages in data/pages/) -->
    <delete model="website.page" id="website.homepage_page"/>
    <delete model="website.page" id="website.contactus_page"/>
    <!---->
  </data>
</odoo>
