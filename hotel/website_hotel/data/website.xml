<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Unlink the existing default website -->
    <delete model="ir.model.data" search="[('module', '=', 'website'), ('name', '=', 'default_website')]"/>

    <!-- Create the demo website with a lower sequence than the one created by Odoo -->
    <record id="website_industry" model="website">
        <field name="name">Hotel</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="logo" type="base64" file="website_hotel/static/src/img/content/logo.webp"/>
        <field name="favicon" type="base64" file="website_hotel/static/src/img/favicon.png"/>
    </record>
</odoo>
