                            </a>
                        </div>
                        <div class="col-lg-8 pt16 pb16 o_colored_level">
                            <nav class="nav align-items-center justify-content-center flex-column flex-lg-row">
                                <a class="nav-link btn btn-custom text-o-color-4" href="#" style="background-color: rgba(0, 0, 0, 0); border-width: 0px; border-color: rgb(128, 93, 78); border-style: none; ">Home</a>
                                <a class="nav-link btn btn-custom text-o-color-4" href="/shop" style="background-color: rgba(0, 0, 0, 0); border-width: 0px; border-color: rgb(128, 93, 78); border-style: none; ">Rooms</a>
                                <a class="nav-link btn btn-custom text-o-color-4" href="/contactus" style="background-color: rgba(0, 0, 0, 0); border-width: 0px; border-color: rgb(128, 93, 78); border-style: none; ">Contact us</a></nav>
                        </div>
                        <div class="col-lg-2 pt16 pb16 o_colored_level">
                            <div class="s_social_media no_icon_color o_not_editable text-center" data-snippet="s_social_media" data-name="Social Media">
                                <h5 class="s_social_media_title d-none">Follow us</h5>
<a href="/website/social/facebook" class="s_social_media_facebook" target="_blank">
                                    <i class="fa fa-facebook fa-stack o_editable_media o_cc o_cc1 rounded-circle"/>
                                </a>
<a href="/website/social/twitter" class="s_social_media_twitter" target="_blank">
                                    <i class="fa fa-twitter fa-stack o_editable_media o_cc o_cc1 rounded-circle"/>
                                </a>
<a href="/website/social/instagram" class="s_social_media_instagram" target="_blank">
                                    <i class="fa fa-instagram fa-stack o_editable_media o_cc o_cc1 rounded-circle"/>
                                </a>
</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </xpath>
</data>
      </field>
      <field name="priority" eval="99"/>
