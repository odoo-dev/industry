    <!-- Héritage classique (A→B→C) : pas de COW, pas de key/website_id -->
    <record id="website_sale_products_oe_structure_website_sale_products_1" model="ir.ui.view">
      <field name="name">Products (oe_structure_website_sale_products_1)</field>
      <field name="type">qweb</field>
      <field name="inherit_id" ref="website_sale.products"/>
      <field name="active" eval="True"/>
      <field name="arch" type="xml">
        <data>
          <xpath expr="//*[hasclass('oe_structure')][@id='oe_structure_website_sale_products_1']" position="replace">
            <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_1">
              <section class="s_kickoff o_cc o_cc5 s_parallax_no_overflow_hidden pt232 pb88 o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-scroll-background-ratio="0" data-oe-shape-data="{&quot;shape&quot;:&quot;html_builder/Connections/06&quot;,&quot;colors&quot;:{&quot;c5&quot;:&quot;#EDEDE9&quot;},&quot;flip&quot;:[],&quot;showOnMobile&quot;:false,&quot;shapeAnimationSpeed&quot;:&quot;0&quot;}" data-snippet="s_kickoff" data-name="Kickoff" data-resize-width="1920" data-mimetype="image/webp" style="background-image: url(&quot;/website_hotel/static/src/img/content/hotel/hotel-image-36.webp&quot;); background-position: 50% 100%;">
        <div class="o_we_bg_filter" style="background-color: rgba(0, 0, 0, 0.5);"/>
        
        <div class="o_we_shape o_html_builder_Connections_06" style="background-image: url(&quot;/html_editor/shape/html_builder%2FConnections%2F06.svg?c5=%23EDEDE9&quot;);"/>
        <div class="container">
            <h1 style="text-align: center;"><span style="font-size: 70px;">All our rooms</span></h1>
        </div>
    </section>
              <div class="s_hr pt32 pb32 o_colored_level" data-snippet="s_hr" data-name="Separator">
        <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
    </div>
            </div>
          </xpath>
        </data>
      </field>
    </record>
