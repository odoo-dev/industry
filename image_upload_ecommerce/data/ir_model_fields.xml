<odoo>
    <record id="field_product_template_allow_image_uploads" model="ir.model.fields">
        <field name="name">x_allow_image_uploads</field>
        <field name="model">product.template</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="ttype">boolean</field>
        <field name="field_description">Allow Image Uploads</field>
    </record>

    <record id="field_sale_order_line_custom_image" model="ir.model.fields">
        <field name="name">x_custom_image</field>
        <field name="model">sale.order.line</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="ttype">binary</field>
        <field name="field_description">Custom Image</field>
    </record>
</odoo>