<odoo>
    <record id="view_product_template_form_inherit_allow_image" model="ir.ui.view">
        <field name="name">product.template.form.inherit.allow.image</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Insert field at the end of group_general -->
            <xpath expr="//page[@name='general_information']/group/group[@name='group_general']" position="inside">
                <field name="x_allow_image_uploads"/>
            </xpath>
        </field>
    </record>
</odoo>