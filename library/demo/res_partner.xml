<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <record id="res_partner_28" model="res.partner">
    <field name="name">John</field>
    <field name="employee" eval="True"/>
    <field name="company_id" ref="base.main_company"/>
  </record>
  <record id="base.main_partner" model="res.partner" forcecreate="1" context="{'default_is_company': True}">
    <field name="name">Odoo Library</field>
    <field name="is_published" eval="True"/>
    <field name="company_id" eval="None"/>
    <field name="website">http://odoo.com</field>
    <field name="street">Rue des Bourlottes 9</field>
    <field name="zip">1367</field>
    <field name="city">Ramillies</field>
    <field name="email">hello@example.com</field>
    <field name="phone">+1 650-691-3277</field>
    <field name="is_company" eval="True"/>
  </record>
