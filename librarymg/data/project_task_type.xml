<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">

    <record id="task_stage_inbox" model="project.task.type">
        <field name="name">Inbox</field>
        <field name="sequence">1</field>
    </record>

    <record id="task_stage_today" model="project.task.type">
        <field name="name">Today</field>
        <field name="sequence">2</field>
    </record>

    <record id="task_stage_week" model="project.task.type">
        <field name="name">This Week</field>
        <field name="sequence">3</field>
    </record>

    <record id="task_stage_month" model="project.task.type">
        <field name="name">This Month</field>
        <field name="sequence">4</field>
    </record>

    <record id="task_stage_later" model="project.task.type">
        <field name="name">Later</field>
        <field name="sequence">5</field>
    </record>

    <record id="task_stage_done" model="project.task.type">
        <field name="name">Done</field>
        <field name="sequence">6</field>
        <field name="fold" eval="True"/>
    </record>

    <record id="task_stage_cancelled" model="project.task.type">
        <field name="name">Cancelled</field>
        <field name="sequence">7</field>
        <field name="fold" eval="True"/>
    </record>

</odoo>
