<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Keep the products from data on the original website: the demo website
         has its own catalog. -->
    <record id="product_template_4" model="product.template">
        <field name="website_id" model="website" eval="obj().env['website'].search([('id', '!=', ref('website_industry'))], order='id', limit=1).id"/>
    </record>
    <record id="product_template_5" model="product.template">
        <field name="website_id" model="website" eval="obj().env['website'].search([('id', '!=', ref('website_industry'))], order='id', limit=1).id"/>
    </record>
    <record id="product_template_6" model="product.template">
        <field name="website_id" model="website" eval="obj().env['website'].search([('id', '!=', ref('website_industry'))], order='id', limit=1).id"/>
    </record>
    <record id="product_template_8" model="product.template">
        <field name="image_1920" type="bytes" file="members_club/static/src/binary/product_template/8-image_1920.jpg"/>
        <field name="name">Members</field>
        <field name="description_sale">For those discovering the club. Access to the essentials, perfect for getting acquainted with the space.</field>
        <field name="type">service</field>
        <field name="service_tracking">partnership</field>
        <field name="list_price">1000.0</field>
        <field name="grade_id" ref="res_partner_grade_4"/>
        <field name="website_id" ref="website_industry"/>
        <field name="is_published" eval="True"/>
        <field name="public_categ_ids" eval="[(6, 0, [ref('product_public_category_10')])]"/>
    </record>
    <record id="product_template_9" model="product.template">
        <field name="image_1920" type="bytes" file="members_club/static/src/binary/product_template/8-image_1920.jpg"/>
        <field name="name">Recurring Members</field>
        <field name="description_sale">The essentials of the Members tier, renewed automatically every year at a lower rate.</field>
        <field name="type">service</field>
        <field name="service_tracking">partnership</field>
        <field name="list_price">890.0</field>
        <field name="grade_id" ref="partnership.res_partner_grade_data_gold"/>
        <field name="recurring_invoice" eval="True"/>
        <field name="website_id" ref="website_industry"/>
        <field name="is_published" eval="True"/>
        <field name="public_categ_ids" eval="[(6, 0, [ref('product_public_category_10')])]"/>
        <field name="subscription_rule_ids" eval="[
            (0, 0, {'fixed_price': 890.0, 'plan_id': ref('sale_subscription.subscription_plan_year')}),
            (0, 0, {'fixed_price': 90.0, 'plan_id': ref('sale_subscription.subscription_plan_month')}),
        ]"/>
    </record>
    <record id="product_template_10" model="product.template">
        <field name="image_1920" type="bytes" file="members_club/static/src/binary/product_template/10-image_1920.jpg"/>
        <field name="name">Gold Members</field>
        <field name="description_sale">For those who see the club as a second home. Full access, priority booking and dedicated support.</field>
        <field name="type">service</field>
        <field name="service_tracking">partnership</field>
        <field name="list_price">2500.0</field>
        <field name="grade_id" ref="res_partner_grade_5"/>
        <field name="website_id" ref="website_industry"/>
        <field name="is_published" eval="True"/>
        <field name="public_categ_ids" eval="[(6, 0, [ref('product_public_category_10')])]"/>
    </record>
</odoo>
