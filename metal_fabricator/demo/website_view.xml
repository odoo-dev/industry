                <h1>Contact us</h1>
              </div>
            </section>
            <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
              <div class="s_allow_columns container">
                <div class="row">
                  <div class="col-lg-7 mt-4 mt-lg-0 o_colored_level">
                    <p class="lead">
                                    Contact us about anything related to our company or services.<br/>
                                    We'll do our best to get back to you as soon as possible.
                                </p>
                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                      <div class="container">
                        <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                          <div class="s_website_form_rows row s_col_no_bgcolor">
                            <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char">
                              <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ozh20uypdxie">
                                  <span class="s_website_form_label_content">Your Name</span>
                                  <span class="s_website_form_mark"> *</span>
                                </label>
                                <div class="col-sm">
                                  <input class="form-control s_website_form_input" type="text" name="contact_name" required="1" data-fill-with="name" id="ozh20uypdxie"/>
                                </div>
                              </div>
                            </div>
                            <div data-name="Field" class="s_website_form_field mb-3 col-12" data-type="tel">
                              <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ofd9p2b7jjjh">
                                  <span class="s_website_form_label_content">Phone Number</span>
                                </label>
                                <div class="col-sm">
                                  <input class="form-control s_website_form_input" type="tel" name="phone" data-fill-with="phone" id="ofd9p2b7jjjh"/>
                                </div>
                              </div>
                            </div>
                            <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="email">
                              <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="o4n264vzoekn">
                                  <span class="s_website_form_label_content">Your Email</span>
                                  <span class="s_website_form_mark"> *</span>
                                </label>
                                <div class="col-sm">
                                  <input class="form-control s_website_form_input" type="email" name="email_from" required="1" data-fill-with="email" id="o4n264vzoekn"/>
                                </div>
                              </div>
                            </div>
                            <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="char">
                              <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="ozz62iv8pfmk">
                                  <span class="s_website_form_label_content">Your Company</span>
                                  <span class="s_website_form_mark"> *</span>
                                </label>
                                <div class="col-sm">
                                  <input class="form-control s_website_form_input" type="text" name="partner_name" required="1" data-fill-with="commercial_company_name" id="ozz62iv8pfmk"/>
                                </div>
                              </div>
                            </div>
                            <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_model_required" data-type="char">
                              <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="opqpcgyft2kl">
                                  <span class="s_website_form_label_content">Subject</span>
                                  <span class="s_website_form_mark"> *</span>
                                </label>
                                <div class="col-sm">
                                  <input class="form-control s_website_form_input" type="text" name="name" required="" id="opqpcgyft2kl"/>
                                </div>
                              </div>
                            </div>
                            <div data-name="Field" class="s_website_form_field mb-3 col-12 s_website_form_required" data-type="text">
                              <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="orkht9n5fror">
                                  <span class="s_website_form_label_content">Your Question</span>
                                  <span class="s_website_form_mark"> *</span>
                                </label>
                                <div class="col-sm">
                                  <textarea class="form-control s_website_form_input" name="description" required="1" id="orkht9n5fror" rows="3"/>
                                </div>
                              </div>
                            </div>
                            <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                              <div style="width: 200px;" class="s_website_form_label"/>
                              <a href="#" role="button" class="btn btn-primary s_website_form_send">Submit</a>
                              <span id="s_website_form_result" class="me-2 small text-danger"/>
                            </div>
                          </div>
                        </form>
                      </div>
                    </section>
                  </div>
                  <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0 o_colored_level">
                    <h5>My Company</h5>
                    <ul class="list-unstyled mb-0 ps-2">
                      <li>
                        <i class="fa fa-map-marker fa-fw me-2"/>
                        <span class="o_force_ltr">3575 Fake Buena Vista Avenue</span>
                      </li>
                      <li>
                        <i class="fa fa-phone fa-fw me-2"/>
                        <span class="o_force_ltr">+1 555-555-5556</span>
                      </li>
                      <li>
                        <i class="fa fa-1x fa-fw fa-envelope me-2"/>
                        <span>info@yourcompany.example.com</span>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </t>
      </t>
    </field>
    <field name="key">website.contactus</field>
    <field name="name">Contact Us</field>
    <field name="type">qweb</field>
    <field name="website_id" ref="website.default_website"/>
  </record>
  <record id="homepage" model="ir.ui.view">
    <field name="arch" type="xml">
      <t name="Homepage" t-name="website.homepage">
        <t t-call="website.layout">
          <t t-set="pageName" t-value="'homepage'"/>
          <div id="wrap" class="oe_structure">
            <section class="s_cover parallax o_cc o_cc5 o_half_screen_height pt0 pb0 o_colored_level" data-scroll-background-ratio="1.5" data-snippet="s_cover">
              <span class="s_parallax_bg oe_img_bg o_bg_img_center o_bg_img_origin_border_box" style="background-image: url(&quot;/web/image/metal_fabricator.ir_attachment_8&quot;); background-position: 50% 75%;"/>
              <div class="o_we_bg_filter bg-black-50"/>
              <div class="container s_allow_columns">
                <h1 style="text-align: center;">Metal Fabricator</h1>
                <p class="lead" style="text-align: center;">As a custom metal fabricator, we specialize in creating bespoke metal solutions tailored to your exact specifications.</p>
                <p style="text-align: center;">
                  <a class="btn btn-secondary mb-2 o_translate_inline" href="/contactus">Get your project started</a>
                </p>
              </div>
            </section>
            <section class="s_title o_cc o_cc2 pt64 pb0 o_colored_level" data-vcss="001" data-snippet="s_title">
              <div class="container s_allow_columns">
                <h2 style="text-align: left;">All our fabrication services</h2>
              </div>
            </section>
            <section class="s_three_columns o_cc o_cc2 o_colored_level pt0 pb64" data-vxml="001" data-vcss="001" data-snippet="s_three_columns">
              <div class="container">
                <div class="row d-flex align-items-stretch">
                  <div data-name="Card" class="col-lg-4 pt16 pb0">
                    <div class="s_card o_card_img_top card h-100 o_cc o_cc1 my-0 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                      <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                        <img src="/web/image/metal_fabricator.ir_attachment_9" alt="black and white floor tiles" data-attachment-id="1259" class="o_card_img card-img-top img img-fluid o_we_custom_image"/>
                      </figure>
                      <div class="card-body">
                        <h5 class="card-title">
        Custom Metal Product&amp;nbsp;<br/></h5>
                        <p class="card-text">
        Looking for a unique metal piece? Our expertise lies in <b>custom metal products</b>, where we design and fabricate solutions for any project. Whether you need a functional <b>bike rack</b>, a stunning <b>range hood</b>, or custom <b>table legs</b>, we have the capabilities to create almost anything you can envision.<br/><br/>
                        </p>
                      </div>
                    </div>
                  </div>
                  <div data-name="Card" class="col-lg-4 pt16 pb16">
                    <div class="s_card o_card_img_top card h-100 o_cc o_cc1 my-0 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                      <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                        <img class="o_card_img card-img-top" src="/web/image/metal_fabricator.ir_attachment_3" alt="" loading="lazy"/>
                      </figure>
                      <div class="card-body">
                        <h5 class="card-title">
        All industries&amp;nbsp;<br/></h5>
                        <p class="card-text">&amp;nbsp;Our expertise extends across diverse industries. We provide custom metal fabrication services for both <b>individuals</b> and <b>businesses</b> in sectors like <b>agriculture</b>, <b>automotive</b>, and <b>pharmaceuticals</b>, ensuring we meet the unique demands of each project.</p>
                      </div>
                    </div>
                  </div>
                  <div data-name="Card" class="col-lg-4 pt16 pb16">
                    <div class="s_card o_card_img_top card h-100 o_cc o_cc1 my-0 o_colored_level" data-vxml="001" data-snippet="s_card" data-name="Card">
                      <figure class="o_card_img_wrapper ratio ratio-16x9 mb-0">
                        <img class="o_card_img card-img-top" src="/web/image/metal_fabricator.ir_attachment_2" alt="" loading="lazy"/>
                      </figure>
                      <div class="card-body"><h5 class="card-title">
        Project&amp;nbsp;<br/></h5><p class="card-text">&amp;nbsp;For larger projects, we offer comprehensive services that include <b>on-site installation</b> and meticulous project management, ensuring a smooth and successful completion from start to finish.</p>&amp;nbsp;<br/></div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </t>
      </t>
    </field>
    <field name="key">metal_fabricator.homepage</field>
    <field name="name">Home</field>
    <field name="type">qweb</field>
    <field name="website_id" ref="website.default_website"/>
  </record>
