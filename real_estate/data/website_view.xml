<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!--
      Site-wide /shop customizations. The website itself, its pages and its
      per-website view overrides live in demo/website/.
    -->
    <template inherit_id='website_sale.cta_wrapper' id="product" name="rename of add to cart">
        <xpath expr="//a[@id='add_to_cart']" position="replace">
            <a data-animation-selector=".o_wsale_product_images" role="button" id="interested_in_this_property"
            t-attf-class="btn btn-primary js_check_product flex-grow-1" href="#Interested-in-this-property"
            class="btn btn-primary js_check_product flex-grow-1">
                <i class="fa fa-envelope me-2"/> Contact us
            </a>
        </xpath>
    </template>
    <template inherit_id='website_sale.product_quantity' id="quantity" name="remove quantity selector">
        <xpath expr="//div[@id='add_to_cart_wrap']//a[hasclass('css_quantity_minus')]" position="replace"></xpath>
        <xpath expr="//div[@id='add_to_cart_wrap']//input[@name='add_qty']" position="replace"></xpath>
        <xpath expr="//div[@id='add_to_cart_wrap']//a[hasclass('css_quantity_plus')]" position="replace"></xpath>
    </template>

    <function model="ir.ui.view" name="write">
        <value eval="[ref('website_sale.product_terms_and_conditions')]" />
        <value eval="{'active': False}" />
    </function>

    <function model="ir.ui.view" name="write">
        <value eval="[ref('website.header_search_box')]" />
        <value eval="{'active': False}" />
    </function>

    <function model="ir.ui.view" name="write">
        <value eval="[ref('website_sale.product_picture_magnify_click')]" />
        <value eval="{'active': True}" />
    </function>

    <!-- Studio fields the website form builder is allowed to write. -->
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value eval="'crm.lead'"/>
        <value eval="['x_interested_in_id']"/>
    </function>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value eval="'res.partner'"/>
        <value eval="[
            'x_criteria_ids',
            'x_subscribe',
            'x_categories_ids',
            'x_max_price',
            'x_min_price',
        ]"/>
    </function>
</odoo>
