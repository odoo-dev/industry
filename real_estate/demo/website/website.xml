<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Create the demo website with a lower sequence than the one created by Odoo -->
    <record id="website_industry" model="website">
        <field name="name">Country</field>
        <field name="sequence">1</field>
        <field name="configurator_done" eval="True"/>
        <field name="user_id" ref="base.public_user"/>
        <field name="salesperson_id" ref="base.user_admin"/>
        <field name="logo" type="base64" file="real_estate/static/src/img/content/website/logo.svg"/>
        <field name="favicon" type="base64" file="real_estate/static/src/img/content/website/favicon.png"/>
        <!-- /shop layout: kept from the module's previous website record -->
        <field name="cart_recovery_mail_template_id" eval="False"/>
        <field name="shop_ppr">3</field>
        <field name="shop_gap">13px</field>
        <field name="product_page_image_layout">grid</field>
        <field name="product_page_image_width">66_pc</field>
        <field name="product_page_image_spacing">medium</field>
        <field name="product_page_image_roundness">big</field>
    </record>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[
            ('name', '=', 'default_website'),
            ('module', '=', 'base'),
            ('model', '=', 'website'),
        ]"/>
        <value eval="{'res_id': ref('website_industry')}"/>
    </function>
</odoo>
