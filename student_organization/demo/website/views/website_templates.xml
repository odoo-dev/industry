<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="footer_custom" model="ir.ui.view">
        <field name="name">Custom - Default</field>
        <field name="key">website.footer_custom</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='footer']" position="replace">
                <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;">
                    <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                        <div class="container">
                            <div class="row">
                                <div class="pb24 o_colored_level col-lg-2 pt16">
                                    <p>
                                        <img src="/web/image/student_organization.img_student_organization_image_08" alt="Unio" class="img img-fluid o_we_custom_image" loading="lazy" style="width: 50% !important;"/>
                                    </p>
                                    <p>A place for students to learn, share &amp; collaborate</p>
                                    <p>
                                        <br/>
                                    </p>
                                    <p>
                                        <a href="/contactus" class="o_translate_inline btn btn-primary">Join us</a>
                                    </p>
                                </div>
                                <div class="pb24 o_colored_level pt24 offset-lg-5 col-lg-2">
                                    <p>
                                        <span class="o_small-fs"><strong><span class="text-o-color-1">PAGES</span></strong></span>
                                    </p>
                                    <ul class="list-unstyled">
                                        <li><a href="/">Home</a></li>
                                        <li><a href="/about">About</a></li>
                                        <li><a href="/event" class="o_translate_inline">Events</a></li>
                                        <li><a href="/shop" class="o_translate_inline">Shop</a></li>
                                        <li><a href="/contactus" class="o_translate_inline">Join us</a></li>
                                    </ul>
                                </div>
                                <div class="pb24 o_colored_level pt24 offset-lg-1 col-lg-2">
                                    <p>
                                        <span class="o_small-fs"><strong><span class="text-o-color-1">CONTACT</span></strong></span>
                                    </p>
                                    <p>
                                        <a href="mailto:hello@unio.example.com" class="o_translate_inline">hello@unio.example.com</a>
                                    </p>
                                    <p>
                                        <a href="tel:+15555555556" class="o_translate_inline">+1 555-555-5556</a>
                                    </p>
                                    <div>Weekdays 2–6pm, and every Thursday till late</div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </xpath>
        </field>
    </record>
    <record id="footer_copyright_company_name" model="ir.ui.view">
        <field name="name">Custom - Footer Copyright</field>
        <field name="key">website.footer_copyright_company_name</field>
        <field name="inherit_id" ref="website.layout"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
                <span class="o_footer_copyright_name me-2 small" t-ignore="true">
                    <span class="o_small-fs">© UNIO - ALL RIGHTS RESERVED</span>
                </span>
            </xpath>
            <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]/.." position="attributes">
                <attribute name="class" remove="text-sm-start" add="d-flex flex-column-reverse gap-2 text-md-start" separator=" "/>
            </xpath>
        </field>
    </record>
    <record id="event_index_topbar" model="ir.ui.view">
        <field name="name">Custom - Events Topbar</field>
        <field name="key">student_organization.event_index_topbar</field>
        <field name="inherit_id" ref="website_event.index_topbar"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//section[hasclass('o_wevent_index_topbar_filters')]//h1" position="replace">
                <h2 class="mb-0">Latest events</h2>
            </xpath>
        </field>
    </record>
    <record id="event_index" model="ir.ui.view">
        <field name="name">Custom - Events</field>
        <field name="key">student_organization.event_index</field>
        <field name="inherit_id" ref="website_event.index"/>
        <field name="website_id" ref="website_industry"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='oe_structure_we_index_0']" position="inside">
                <section class="s_text_block o_colored_level pt104 pb56" data-snippet="s_text_block" data-name="Text">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="o_colored_level offset-lg-2 col-lg-8">
                                <p class="text-center">
                                    <span class="o_small-fs text-600"><strong><span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;"><span class="fa fa-circle text-o-color-2" style="padding-right: 6px;"/>UPCOMING EVENTS</span></strong></span>
                                </p>
                                <h1 class="text-center">
                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">SOMETHING'S <span class="bg-o-color-1">ALWAYS ON</span></span>
                                </h1>
                                <p class="text-center lead">
                                    <span class="o_animated_text o_animate o_anim_fade_in o_visible o_anim_from_bottom" style="--wanim-intensity: 15; animation-duration: 0.5s;">Everything here is free for members and open to newcomers.&amp;nbsp;<br/>Turn up alone — you won't leave that way.</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
            </xpath>
            <xpath expr="//div[@id='oe_structure_we_index_2']" position="inside">
                <div class="s_hr pb32 o_colored_level pt64 d-lg-block d-none o_snippet_mobile_invisible" data-snippet="s_hr" data-name="Separator" data-invisible="1">
                    <hr class="w-100 mx-auto" style="border-top-width: 0px;"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
