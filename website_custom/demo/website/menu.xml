<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Website menus - parent_id via search on root (url=#) -->
    <!-- Custom menu: Matchmaking -->
    <record id="menu_matchmaking" model="website.menu">
      <field name="name">Matchmaking</field>
      <field name="url">/match</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('website_custom.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="1"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Custom menu: Events -->
    <record id="menu_events" model="website.menu">
      <field name="name">Events</field>
      <field name="url">/event</field>
      <field name="parent_id" model="website.menu" search="[('url', '=', '#'), ('website_id', '=', ref('website_custom.website_industry'))]"/>
      <field name="website_id" ref="website_industry"/>
      <field name="sequence" eval="2"/>
      <field name="is_visible" eval="True"/>
    </record>
    <!-- Default menu (rename/reorder): Properties -->
    <function name="write" model="website.menu">
      <value model="website.menu" search="[('url', '=', '/shop'), ('website_id', '=', ref('website_custom.website_industry'))]"/>
      <value eval="{'name': 'Properties', 'sequence': 10, 'is_visible': True}"/>
    </function>
  </data>
</odoo>
