<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1" context="{'mail_auto_subscribe_no_notify': True}">
    <!-- Confirmed eCommerce orders on the demo website: they feed the
         "Best Sales" (latest sold products) snippet of the homepage -->
    <record id="sale_order_website_1" model="sale.order">
        <field name="partner_id" ref="base_industry_data.res_partner_27"/>
        <field name="pricelist_id" ref="product_pricelist_1"/>
        <field name="website_id" ref="website_industry"/>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="sale_order_website_1_line_1" model="sale.order.line">
        <field name="order_id" ref="sale_order_website_1"/>
        <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('product_template_17'))]"/>
        <field name="product_uom_qty" eval="6"/>
    </record>
    <record id="sale_order_website_1_line_2" model="sale.order.line">
        <field name="order_id" ref="sale_order_website_1"/>
        <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('product_template_18'))]"/>
        <field name="product_uom_qty" eval="3"/>
    </record>
    <record id="sale_order_website_2" model="sale.order">
        <field name="partner_id" ref="base_industry_data.res_partner_28"/>
        <field name="pricelist_id" ref="product_pricelist_1"/>
        <field name="website_id" ref="website_industry"/>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="sale_order_website_2_line_1" model="sale.order.line">
        <field name="order_id" ref="sale_order_website_2"/>
        <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('product_template_27'))]"/>
        <field name="product_uom_qty" eval="6"/>
    </record>
    <record id="sale_order_website_2_line_2" model="sale.order.line">
        <field name="order_id" ref="sale_order_website_2"/>
        <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('product_template_21'))]"/>
        <field name="product_uom_qty" eval="2"/>
    </record>
    <record id="sale_order_website_3" model="sale.order">
        <field name="partner_id" ref="base_industry_data.res_partner_29"/>
        <field name="pricelist_id" ref="product_pricelist_1"/>
        <field name="website_id" ref="website_industry"/>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="sale_order_website_3_line_2" model="sale.order.line">
        <field name="order_id" ref="sale_order_website_3"/>
        <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('product_template_23'))]"/>
        <field name="product_uom_qty" eval="2"/>
    </record>
    <record id="sale_order_website_4" model="sale.order">
        <field name="partner_id" ref="base_industry_data.res_partner_30"/>
        <field name="pricelist_id" ref="product_pricelist_1"/>
        <field name="website_id" ref="website_industry"/>
        <field name="user_id" ref="base.user_admin"/>
    </record>
    <record id="sale_order_website_4_line_1" model="sale.order.line">
        <field name="order_id" ref="sale_order_website_4"/>
        <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('product_template_579'))]"/>
        <field name="product_uom_qty" eval="1"/>
    </record>
    <record id="sale_order_website_4_line_2" model="sale.order.line">
        <field name="order_id" ref="sale_order_website_4"/>
        <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('product_template_564'))]"/>
        <field name="product_uom_qty" eval="2"/>
    </record>
    <function model="sale.order" name="action_confirm" eval="[[ref('sale_order_website_1'),ref('sale_order_website_2'),ref('sale_order_website_3'),ref('sale_order_website_4')]]" context="{'install_mode': True}"/>
    <!-- action_confirm resets date_order to now: spread the orders in time -->
    <record id="sale_order_website_1" model="sale.order">
        <field name="date_order" eval="(DateTime.now() - relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="sale_order_website_2" model="sale.order">
        <field name="date_order" eval="(DateTime.now() - relativedelta(days=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="sale_order_website_3" model="sale.order">
        <field name="date_order" eval="(DateTime.now() - relativedelta(days=6)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="sale_order_website_4" model="sale.order">
        <field name="date_order" eval="(DateTime.now() - relativedelta(days=9)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
